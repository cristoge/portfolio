---
import '../styles/global.css';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import { getDictionary, unlocalizedPath, type Lang, type Page } from '../i18n/utils';
import { HOME_REVEALED_CLASS, HOME_REVEALED_KEY, THEME_KEY } from '../lib/storage';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  // Enlace del menú que se marca como actual.
  activePage?: Page;
  // Portada: bloquea el scroll en el hero hasta pulsar "Veure-ho tot" (ver Hero.astro).
  lockHero?: boolean;
}

const { lang, title, description, activePage, lockHero = false } = Astro.props;
const t = getDictionary(lang);
const path = unlocalizedPath(Astro.url.pathname);
---

<!doctype html>
<html lang={lang} data-hero-lock={lockHero ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Se ejecuta antes de pintar para que no parpadee el tema ni el hero. -->
    <script define:vars={{ THEME_KEY, HOME_REVEALED_KEY, HOME_REVEALED_CLASS }}>
      const root = document.documentElement;
      root.classList.add('js');
      try {
        const stored = localStorage.getItem(THEME_KEY);
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          root.dataset.theme = 'dark';
        }
      } catch {}
      // Al recargar se vuelve a mostrar el hero; al navegar se recuerda si ya se desplegó.
      try {
        const [entry] = performance.getEntriesByType('navigation');
        const isReload = entry ? entry.type === 'reload' : performance.navigation?.type === 1;

        if (isReload) {
          sessionStorage.removeItem(HOME_REVEALED_KEY);
        } else if (sessionStorage.getItem(HOME_REVEALED_KEY) === 'true') {
          root.classList.add(HOME_REVEALED_CLASS);
        }
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t.nav.skipLink}</a>
    <Nav lang={lang} path={path} activePage={activePage} />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Hace aparecer los elementos `.reveal` al entrar en pantalla.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
