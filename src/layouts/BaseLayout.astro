---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getDictionary, type Lang, type Page } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: Page;
  path?: string;
  title: string;
  description?: string;
}

const { lang, page, path, title, description = '' } = Astro.props;
const isHomeHero = page === 'home' && !path;
const t = getDictionary(lang);
---

<!doctype html>
<html lang={lang} data-hero-lock={isHomeHero ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {}
      try {
        const [entry] = performance.getEntriesByType('navigation');
        const isReload = entry ? entry.type === 'reload' : performance.navigation?.type === 1;

        if (isReload) {
          sessionStorage.removeItem('home-revealed');
        } else if (sessionStorage.getItem('home-revealed') === 'true') {
          document.documentElement.classList.add('home-revealed');
        }
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t.nav.skipLink}</a>
    <Nav lang={lang} page={page} path={path} />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      const revealed = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            revealed.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );

      document.querySelectorAll('.reveal').forEach((el) => revealed.observe(el));
    </script>
  </body>
</html>
