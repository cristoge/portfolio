---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Lang, Page } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: Page;
  path?: string;
  title: string;
  description?: string;
}

const { lang, page, path, title, description = '' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      try {
        const [entry] = performance.getEntriesByType('navigation');
        const isReload = entry ? entry.type === 'reload' : performance.navigation?.type === 1;

        if (isReload) {
          sessionStorage.removeItem('home-revealed');
        } else if (sessionStorage.getItem('home-revealed') === 'true') {
          document.documentElement.classList.add('home-revealed');
        }
      } catch {}
    </script>
  </head>
  <body>
    <Nav lang={lang} page={page} path={path} />
    <main class="container">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
