---
import '../styles/global.css';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import { getDictionary, unlocalizedPath, type Lang, type Page } from '../i18n/utils';
import { INTRO_ACTIVE_CLASS, INTRO_SEEN_KEY, THEME_KEY } from '../lib/storage';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  // Enlace del menú que se marca como actual.
  activePage?: Page;
  // Portada: puede mostrar la intro en forma de terminal (ver TerminalIntro.astro).
  intro?: boolean;
}

const { lang, title, description, activePage, intro = false } = Astro.props;
const t = getDictionary(lang);
const path = unlocalizedPath(Astro.url.pathname);
---

<!doctype html>
<html lang={lang} data-intro-page={intro ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Se ejecuta antes de pintar para que no parpadee el tema ni la intro. -->
    <script define:vars={{ THEME_KEY, INTRO_SEEN_KEY, INTRO_ACTIVE_CLASS }}>
      const root = document.documentElement;
      root.classList.add('js');
      try {
        const stored = localStorage.getItem(THEME_KEY);
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          root.dataset.theme = 'dark';
        }
      } catch {}
      // Intro en forma de terminal de la portada: la primera visita o con ?intro.
      try {
        const forced = new URLSearchParams(location.search).has('intro');
        if (root.hasAttribute('data-intro-page') && (forced || localStorage.getItem(INTRO_SEEN_KEY) !== 'true')) {
          root.classList.add(INTRO_ACTIVE_CLASS);
        }
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t.nav.skipLink}</a>
    <Nav lang={lang} path={path} activePage={activePage} />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Hace aparecer los elementos `.reveal` al entrar en pantalla.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
