---
import { getDictionary, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const contactEmail = t.contact.links.find((l) => l.label === 'Email')?.value ?? '';
const linkedin = t.contact.links.find((l) => l.label === 'LinkedIn');
const linkedinHandle = linkedin?.value.split('/').pop() ?? '';

const icons: Record<string, string> = {
  Email:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>',
  LinkedIn:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
};
---

<section class="contact-section">
  <p class="kicker">{t.contact.kicker}</p>
  <h1>{t.contact.heading}</h1>
  <p class="contact-body">{t.contact.body}</p>
  <div class="contact-icons">
    <span class="contact-pill contact-email" title={contactEmail}>
      <span class="contact-pill-icon" set:html={icons.Email} />
      <span class="contact-pill-value">{contactEmail}</span>
    </span>
    {linkedin && (
      <a
        href={linkedin.href}
        class="contact-pill contact-icon"
        aria-label={`LinkedIn: ${linkedin.value}`}
        title={linkedin.value}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact-pill-icon" set:html={icons.LinkedIn} />
        <span class="contact-pill-value">{linkedinHandle}</span>
      </a>
    )}
  </div>

  <div class="card contact-box">
    <h2 class="card-heading">{t.contact.map.heading}</h2>
    <p class="map-caption">{t.contact.map.caption}</p>
    <div class="map-embed">
      <iframe
        src="https://www.google.com/maps?q=Esplugues+de+Llobregat&output=embed"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={t.contact.map.heading}
      ></iframe>
    </div>

    <h2 class="card-heading form-heading">{t.contact.form.heading}</h2>
    <form id="contact-form" class="contact-form">
      <div class="form-row">
        <label class="form-field">
          <span>{t.contact.form.nameLabel}</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label class="form-field">
          <span>{t.contact.form.emailLabel}</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
      </div>
      <label class="form-field">
        <span>{t.contact.form.messageLabel}</span>
        <textarea name="message" rows="5" required></textarea>
      </label>
      <button type="submit" class="btn btn-primary">{t.contact.form.submitLabel}</button>
    </form>
  </div>
</section>

<script define:vars={{
  contactEmail,
  subject: t.contact.form.subject,
  nameLabel: t.contact.form.nameLabel,
  emailLabel: t.contact.form.emailLabel,
}}>
  const form = document.getElementById('contact-form');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = (data.get('name') || '').toString().trim();
    const email = (data.get('email') || '').toString().trim();
    const message = (data.get('message') || '').toString().trim();

    const mailSubject = encodeURIComponent(`${subject} — ${name}`);
    const mailBody = encodeURIComponent(`${nameLabel}: ${name}\n${emailLabel}: ${email}\n\n${message}`);

    window.location.href = `mailto:${contactEmail}?subject=${mailSubject}&body=${mailBody}`;
  });
</script>

<style>
  .contact-section {
    padding: 56px 0;
  }

  .contact-body {
    margin-top: 16px;
    max-width: 52ch;
    color: var(--ink-soft);
  }

  .contact-icons {
    margin-top: 24px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 18px;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    color: var(--forest);
    text-decoration: none;
  }

  .contact-pill-icon {
    display: inline-flex;
    flex-shrink: 0;
    line-height: 0;
  }

  .contact-pill-icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .contact-pill-value {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink);
  }

  .contact-email {
    cursor: text;
    user-select: all;
  }

  .contact-icon {
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .contact-icon:hover {
    border-color: var(--forest-dim);
    color: var(--forest);
  }

  .contact-box {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card-heading {
    font-size: 16px;
  }

  .form-heading {
    margin-top: 8px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    color: var(--forest);
  }

  .form-field input,
  .form-field textarea {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 400;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    resize: vertical;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--forest-dim);
  }

  .contact-form .btn {
    align-self: flex-start;
    margin-top: 4px;
  }

  .map-caption {
    margin-top: -8px;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--ink-soft);
  }

  .map-embed {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 21 / 9;
  }

  .map-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 640px) {
    .map-embed {
      aspect-ratio: 4 / 3;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
