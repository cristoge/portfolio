---
import { getDictionary, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section class="contact-section">
  <p class="kicker">{t.contact.kicker}</p>
  <h1>{t.contact.heading}</h1>
  <p class="contact-body">{t.contact.body}</p>
  <ul class="contact-links">
    {t.contact.links.map((link) => (
      <li>
        <a href={link.href} class="contact-link card">
          <span class="contact-link-label">{link.label}</span>
          <span class="contact-link-value">{link.value}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .contact-section {
    padding: 56px 0;
  }

  .contact-body {
    margin-top: 16px;
    max-width: 52ch;
    color: var(--ink-soft);
  }

  .contact-links {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .contact-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    color: var(--ink);
  }

  .contact-link:hover {
    border-color: var(--forest-dim);
  }

  .contact-link-label {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    color: var(--forest);
  }

  .contact-link-value {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink-soft);
  }
</style>
