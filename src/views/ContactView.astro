---
import { getDictionary, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const email = t.contact.links.find((l) => l.label === 'Email');
const contactEmail = email?.value ?? '';
const linkedin = t.contact.links.find((l) => l.label === 'LinkedIn');
const linkedinHandle = linkedin?.value.split('/').pop() ?? '';

// Clave pública de Web3Forms (https://web3forms.com), definida en .env — está pensada para ir en el cliente.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

const icons: Record<string, string> = {
  Copy:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>',
  Check:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5 10 17.5 19 7"/></svg>',
  Email:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>',
  LinkedIn:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
};
---

<section class="contact-section">
  <header class="contact-intro">
    <p class="eyebrow">{t.contact.kicker}</p>
    <h1>{t.contact.heading}</h1>
    <p class="contact-body lead">{t.contact.body}</p>
    <div class="contact-links">
      <div class="contact-email">
        <a href={email?.href} class="contact-email-link">
          <span class="contact-link-icon" set:html={icons.Email} />
          <span>{contactEmail}</span>
        </a>
        <button
          type="button"
          class="copy-email"
          aria-label={t.contact.copyEmail.ariaLabel}
          title={t.contact.copyEmail.label}
          data-email={contactEmail}
          data-done={t.contact.copyEmail.done}
        >
          <span class="copy-icon" set:html={icons.Copy} />
          <span class="copy-done-icon" set:html={icons.Check} />
          <span class="visually-hidden copy-email-label" aria-live="polite"></span>
        </button>
      </div>
      {linkedin && (
        <a
          href={linkedin.href}
          class="contact-link"
          aria-label={`LinkedIn: ${linkedin.value}`}
          title={linkedin.value}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-link-icon" set:html={icons.LinkedIn} />
          <span>{linkedinHandle}</span>
        </a>
      )}
    </div>
  </header>

  <div class="contact-block reveal">
    <div class="section-head">
      <div>
        <h2>{t.contact.map.heading}</h2>
        <p class="note map-caption">{t.contact.map.caption}</p>
      </div>
    </div>
    <div class="contact-grid">
      <div class="map-embed">
        <iframe
          src="https://www.google.com/maps?q=Esplugues+de+Llobregat&z=13&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={t.contact.map.heading}
        ></iframe>
      </div>

      <form id="contact-form" class="contact-form">
        <label class="form-field">
          <span>{t.contact.form.nameLabel}</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label class="form-field">
          <span>{t.contact.form.emailLabel}</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label class="form-field form-field-full">
          <span>{t.contact.form.messageLabel}</span>
          <textarea name="message" rows="4" required></textarea>
        </label>
        <input type="checkbox" name="botcheck" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-field-full">
          <button type="submit" class="btn btn-primary"><span class="submit-label">{t.contact.form.submitLabel}</span> <span class="arrow" aria-hidden="true">→</span></button>
          <p class="form-status" role="status" aria-live="polite" hidden></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script define:vars={{
  web3formsKey,
  subject: t.contact.form.subject,
  submitLabel: t.contact.form.submitLabel,
  sendingLabel: t.contact.form.sendingLabel,
  successMessage: t.contact.form.successMessage,
  errorMessage: t.contact.form.errorMessage,
}}>
  const form = document.getElementById('contact-form');
  const button = form?.querySelector('button[type="submit"]');
  const status = form?.querySelector('.form-status');
  const buttonLabel = button?.querySelector('.submit-label');

  const showStatus = (text, kind) => {
    status.textContent = text;
    status.dataset.kind = kind;
    status.hidden = false;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = (data.get('name') || '').toString().trim();

    data.append('access_key', web3formsKey);
    data.append('subject', `${subject} — ${name}`);
    data.append('from_name', name);

    button.disabled = true;
    buttonLabel.textContent = sendingLabel;
    status.hidden = true;

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.message);

      form.reset();
      showStatus(successMessage, 'success');
    } catch {
      showStatus(errorMessage, 'error');
    } finally {
      button.disabled = false;
      buttonLabel.textContent = submitLabel;
    }
  });
</script>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('.copy-email');
  const copyLabel = copyButton?.querySelector('.copy-email-label');
  let resetTimer: number | undefined;

  copyButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyButton.dataset.email ?? '');
    } catch {
      return;
    }
    if (copyLabel) copyLabel.textContent = copyButton.dataset.done ?? '';
    copyButton.classList.add('is-done');
    window.clearTimeout(resetTimer);
    resetTimer = window.setTimeout(() => {
      if (copyLabel) copyLabel.textContent = '';
      copyButton.classList.remove('is-done');
    }, 2000);
  });
</script>

<style>
  .contact-section {
    padding: var(--page-top) 0 clamp(70px, 8vw, 120px);
  }

  .contact-intro {
    padding-bottom: var(--intro-gap);
  }

  .contact-intro h1 {
    margin-top: 24px;
  }

  .contact-body {
    margin-top: 28px;
    max-width: 700px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .contact-intro > * {
      animation: fade-up 0.9s var(--ease-out) both;
    }
    .contact-intro h1 {
      animation-delay: 0.15s;
    }
    .contact-intro > :nth-child(n + 3) {
      animation-delay: 0.3s;
    }
  }

  .contact-links {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Email y LinkedIn en píldoras con borde. */
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 20px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-size: var(--fs-base);
    font-weight: 700;
    transition: background-color 0.2s, color 0.2s;
  }

  .contact-link:hover {
    background: var(--ink);
    color: var(--page);
  }

  .contact-link-icon {
    display: inline-flex;
    line-height: 0;
  }

  .contact-link-icon :global(svg) {
    width: 16px;
    height: 16px;
  }

  /* Píldora del email con el botón de copiar (icono redondo) dentro. */
  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 2px 2px 2px 0;
    border: 2px solid var(--ink);
    border-radius: 999px;
    transition: background-color 0.2s, color 0.2s;
  }

  .contact-email:has(.contact-email-link:hover) {
    background: var(--ink);
    color: var(--page);
  }

  .contact-email-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: stretch;
    padding-left: 20px;
    font-size: var(--fs-base);
    font-weight: 700;
  }

  .copy-email {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: var(--page);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  .copy-email:hover,
  .copy-email.is-done {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--page);
  }

  .copy-icon,
  .copy-done-icon {
    display: inline-flex;
    line-height: 0;
  }

  .copy-icon :global(svg),
  .copy-done-icon :global(svg) {
    width: 17px;
    height: 17px;
  }

  .copy-done-icon,
  .copy-email.is-done .copy-icon {
    display: none;
  }

  .copy-email.is-done .copy-done-icon {
    display: inline-flex;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .contact-block {
    padding: 64px 0;
  }

  .contact-block .section-head {
    margin-bottom: 36px;
  }

  .map-caption {
    margin-top: 14px;
  }

  /* Mapa a la izquierda y formulario a la derecha, a la misma altura. */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: 48px;
  }

  /* La fila del mensaje crece para que el formulario iguale la altura del mapa. */
  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto 1fr auto;
    gap: 18px;
  }

  .contact-form textarea {
    flex: 1;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .form-field-full {
    grid-column: 1 / -1;
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 20px;
    background: var(--field);
    border: 1px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    font-size: var(--fs-base);
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
    resize: vertical;
    transition: border-color 0.2s;
  }

  .form-field textarea {
    border-radius: var(--radius);
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: 1px solid var(--ink);
    outline-offset: 0;
  }

  .contact-form .btn:disabled {
    cursor: wait;
  }

  .form-honeypot {
    display: none;
  }

  .form-status {
    margin-top: 18px;
    font-size: var(--fs-sm);
  }

  .form-status[data-kind='error'] {
    color: var(--danger);
  }

  .map-embed {
    min-height: 400px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .map-embed:focus-within {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  .map-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.6s var(--ease-in-out);
  }

  :global(:root[data-theme='dark']) .map-embed iframe {
    filter: grayscale(1) invert(0.92) contrast(0.9);
  }

  .map-embed:hover iframe,
  :global(:root[data-theme='dark']) .map-embed:hover iframe {
    filter: none;
  }

  @media (max-width: 900px) {
    .contact-block {
      padding: 48px 0;
    }
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .map-embed {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 640px) {
    .contact-form {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .map-embed {
      aspect-ratio: 4 / 3;
    }
  }
</style>
