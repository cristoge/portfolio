---
import { getDictionary, localePath, projectLinkLabels, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = getDictionary(lang);
const project = t.projects.items.find((p) => p.slug === slug);

if (!project) {
  throw new Error(`Unknown project slug: ${slug}`);
}

const { repoLabel, demoLabel } = projectLinkLabels(lang);
const d = t.projects.detail;
---

<article class="project-detail">
  <a href={`${localePath(lang, 'home')}#projects`} class="back-link"><span class="arrow arrow-back" aria-hidden="true">←</span> {d.back}</a>

  <header class="project-header">
    <p class="eyebrow">{d.context}</p>
    <h1>{project.title}</h1>
    <p class="project-summary lead">{project.description}</p>
  </header>

  {project.image ? (
    <img src={project.image} alt={project.title} class="project-hero-image project-hero-photo" />
  ) : (
    <div class="project-hero-image" aria-hidden="true">IMG</div>
  )}

  <p class="project-context">{project.context}</p>

  <section class="detail-block reveal">
    <h2 class="detail-heading">{d.depth}</h2>
    <ol class="depth-list">
      {project.depthTopics.map((topic, i) => (
        <li>
          <span class="depth-num">{String(i + 1).padStart(2, '0')}</span>
          <span>{topic}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="detail-block reveal">
    <h2 class="detail-heading">{d.stackLabel}</h2>
    <div class="pill-row">
      {project.stack.map((tech) => <span class="pill">{tech}</span>)}
    </div>
  </section>

  {project.outcome && (
    <section class="detail-block reveal">
      <h2 class="detail-heading">{d.outcome}</h2>
      <p class="outcome-text">{project.outcome}</p>
    </section>
  )}

  <div class="project-actions">
    <a href={project.repoHref} class="btn btn-primary" target="_blank" rel="noopener noreferrer">{repoLabel} <span class="arrow" aria-hidden="true">→</span></a>
    {project.demoHref && (
      <a href={project.demoHref} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
        {demoLabel} <span class="arrow" aria-hidden="true">→</span>
      </a>
    )}
  </div>
</article>

<style>
  .project-detail {
    padding: var(--page-top) 0 clamp(70px, 8vw, 120px);
    max-width: 960px;
  }

  .back-link {
    display: inline-flex;
    gap: 10px;
    margin-block: -11px 45px;
    padding-block: 11px;
    font-size: var(--fs-sm);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .back-link:hover {
    text-decoration: underline 2px;
    text-underline-offset: 4px;
  }

  .project-header h1 {
    margin-top: 24px;
  }

  .project-summary {
    margin-top: 24px;
    max-width: 68ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-header > * {
      animation: fade-up 0.9s var(--ease-out) both;
    }
    .project-header h1 {
      animation-delay: 0.15s;
    }
    .project-header .project-summary,
    .project-hero-image {
      animation: fade-up 0.9s var(--ease-out) 0.3s both;
    }
  }

  .project-hero-image {
    aspect-ratio: 16 / 6;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 56px 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--fs-2xs);
    font-weight: 800;
    color: var(--muted);
  }

  .project-hero-photo {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .project-context {
    max-width: 68ch;
    color: var(--copy);
    font-size: var(--fs-read);
    line-height: 1.65;
  }

  .detail-block {
    margin-top: 72px;
  }

  .detail-heading {
    margin-bottom: 28px;
    font-size: var(--fs-h3);
  }

  .depth-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .depth-list li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--copy);
    font-size: var(--fs-read);
    line-height: 1.6;
  }

  .depth-list li > span:last-child {
    max-width: 72ch;
  }

  .depth-num {
    padding-top: 3px;
    font-size: var(--fs-sm);
    font-weight: 800;
    color: var(--muted);
  }

  .detail-block .pill-row {
    gap: 8px;
  }

  .outcome-text {
    max-width: 68ch;
    font-size: var(--fs-md);
    line-height: 1.6;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 72px;
  }

  @media (max-width: 640px) {
    .depth-list li {
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 12px;
      font-size: var(--fs-base);
    }
  }
</style>
