---
import { getDictionary, localePath, projectLinkLabels, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = getDictionary(lang);
const project = t.projects.items.find((p) => p.slug === slug);

if (!project) {
  throw new Error(`Unknown project slug: ${slug}`);
}

const { repoLabel, demoLabel } = projectLinkLabels(lang);
const d = t.projects.detail;
---

<article class="project-detail">
  <a href={`${localePath(lang, 'home')}#projects`} class="back-link">← {d.back}</a>

  <p class="kicker">{d.context}</p>
  <h1>{project.title}</h1>
  <p class="project-summary">{project.description}</p>

  {project.image ? (
    <img src={project.image} alt={project.title} class="project-hero-image project-hero-photo" />
  ) : (
    <div class="project-hero-image" aria-hidden="true">IMG</div>
  )}

  <p class="project-context">{project.context}</p>

  <section class="detail-block">
    <h2 class="section-heading">{d.depth}</h2>
    <ul class="depth-list">
      {project.depthTopics.map((topic) => <li>{topic}</li>)}
    </ul>
  </section>

  <section class="detail-block">
    <h2 class="section-heading">{d.stackLabel}</h2>
    <div class="pill-row">
      {project.stack.map((tech) => <span class="pill">{tech}</span>)}
    </div>
  </section>

  {project.outcome && (
    <section class="detail-block">
      <h2 class="section-heading">{d.outcome}</h2>
      <p class="outcome-text">{project.outcome}</p>
    </section>
  )}

  <div class="project-actions">
    <a href={project.repoHref} class="btn btn-outline">{repoLabel} →</a>
    {project.demoHref && <a href={project.demoHref} class="btn btn-primary">{demoLabel} →</a>}
  </div>
</article>

<style>
  .project-detail {
    padding: 64px 0 80px;
    max-width: 760px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--text-soft);
    text-decoration: none;
    margin-bottom: 36px;
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-summary {
    margin-top: 16px;
    font-size: 17px;
    color: var(--text-soft);
  }

  .project-hero-image {
    aspect-ratio: 16 / 6;
    background: var(--surface);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--grey);
    margin: 36px 0;
  }

  .project-hero-photo {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .project-context {
    color: var(--text-soft);
    font-size: 15px;
  }

  .detail-block {
    margin-top: 48px;
  }

  .detail-block .section-heading {
    font-size: 28px;
  }

  .depth-list {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-soft);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .depth-list li {
    position: relative;
    padding-left: 22px;
    line-height: 1.6;
  }

  .depth-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--primary);
  }

  .outcome-text {
    margin-top: 12px;
    color: var(--text-soft);
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 56px;
  }
</style>
