---
import EducationItem from '../components/EducationItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getDictionary, projectDetailPath, projectLinkLabels, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const { repoLabel, demoLabel } = projectLinkLabels(lang);
const github = t.contact.links.find((l) => l.label === 'GitHub');
---

<section class="hero-intro">
  <div class="hero-intro-body">
    <p class="kicker">{t.hero.kicker}</p>
    <h1>{t.hero.greeting} {t.hero.name}</h1>
    <p class="tagline">{t.hero.tagline.join(' | ')}</p>
    <div class="hero-actions">
      <a href={t.hero.ctaHref} class="btn btn-primary" target="_blank" rel="noopener noreferrer">{t.hero.cta}</a>
      {github && (
        <a href={github.href} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      )}
    </div>
    <p class="hero-outro">{t.hero.outro}</p>
  </div>

  <button type="button" id="reveal-toggle" class="scroll-cta" aria-expanded="false" aria-controls="reveal-content">
    <span>{t.hero.exploreCta}</span>
    <svg class="scroll-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="4" x2="12" y2="20"/><polyline points="5 13 12 20 19 13"/></svg>
  </button>
</section>

<div class="reveal-wrap" id="reveal-wrap">
  <div class="reveal-inner" id="reveal-content">
    <section class="section" id="education">
      <h2 class="section-heading">{t.education.heading}</h2>
      <div class="section-note"></div>
      <div class="education-list">
        {t.education.items.map((item) => (
          <EducationItem
            institution={item.institution}
            degree={item.degree}
            dates={item.dates}
            note={item.note}
            grade={item.grade}
            coursework={item.coursework}
            gradeLabel={t.education.gradeLabel}
            courseworkLabel={t.education.courseworkLabel}
          />
        ))}
      </div>
    </section>

    <section class="section" id="projects">
      <h2 class="section-heading">{t.projects.heading}</h2>
      <p class="section-note">{t.projects.note}</p>
      <div class="projects-grid">
        {t.projects.items.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            stack={project.stack}
            detailHref={projectDetailPath(lang, project.slug)}
            repoHref={project.repoHref}
            demoHref={project.demoHref}
            image={project.image}
            detailLabel={t.projects.viewDetail}
            repoLabel={repoLabel}
            demoLabel={demoLabel}
          />
        ))}
      </div>
    </section>

    <section class="section" id="stack">
      <h2 class="section-heading">{t.stack.heading}</h2>
      <div class="stack-list">
        {t.stack.groups.map((group) => (
          <div class="stack-row">
            <span class="stack-label">{group.label}</span>
            <span class="stack-items">{group.items.join(' · ')}</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</div>

<script>
  const toggle = document.getElementById('reveal-toggle');
  const wrap = document.getElementById('reveal-wrap');
  const STORAGE_KEY = 'home-revealed';

  const markRevealed = () => {
    try {
      sessionStorage.setItem(STORAGE_KEY, 'true');
    } catch {
      // ignore (private browsing / storage disabled)
    }
    document.documentElement.classList.add('home-revealed');
    toggle?.setAttribute('aria-expanded', 'true');
  };

  if (document.documentElement.classList.contains('home-revealed')) {
    toggle?.setAttribute('aria-expanded', 'true');
  }

  const hashTarget = window.location.hash && document.getElementById(window.location.hash.slice(1));
  const hasHashTarget = Boolean(wrap && hashTarget && wrap.contains(hashTarget));

  if (hasHashTarget) {
    markRevealed();
    requestAnimationFrame(() => hashTarget.scrollIntoView({ block: 'start' }));
  }

  toggle?.addEventListener('click', () => {
    markRevealed();
    wrap?.scrollIntoView({ block: 'start' });
  });
</script>

<style>
  :global(html[data-hero-lock]:not(.home-revealed)),
  :global(html[data-hero-lock]:not(.home-revealed) body) {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  :global(html[data-hero-lock]:not(.home-revealed) #reveal-wrap),
  :global(html[data-hero-lock]:not(.home-revealed) #site-footer) {
    display: none;
  }

  .hero-intro {
    height: calc(100dvh - var(--nav-h, 65px));
    max-height: calc(100dvh - var(--nav-h, 65px));
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 40px 0 28px;
    overflow: hidden;
  }

  .hero-intro-body {
    max-width: 720px;
    margin: auto 0;
    padding-left: 20px;
  }

  .hero-intro-body > * {
    opacity: 0;
    animation: fade-up 0.7s ease-out forwards;
  }
  .hero-intro-body > :nth-child(2) { animation-delay: 0.12s; }
  .hero-intro-body > :nth-child(3) { animation-delay: 0.24s; }
  .hero-intro-body > :nth-child(4) { animation-delay: 0.36s; }
  .hero-intro-body > :nth-child(5) { animation-delay: 0.48s; }

  .hero-intro h1 {
    font-family: var(--font-display);
    font-weight: 100;
    font-size: 72px;
    line-height: 1.05;
  }

  .tagline {
    font-family: var(--font-ui);
    font-size: 16px;
    color: var(--text-soft);
    margin-top: 20px;
  }

  .hero-actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-outro {
    margin-top: 32px;
    color: var(--text-soft);
    font-size: 14px;
  }

  :global(html.home-revealed) .scroll-cta {
    display: none;
  }

  .scroll-cta {
    align-self: center;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 300;
    transition: color var(--ease);
  }

  .scroll-cta:hover {
    color: var(--accent);
  }

  .scroll-arrow {
    width: 34px;
    height: 34px;
    padding: 8px;
    border-radius: 5px;
    background: var(--primary);
    color: var(--on-primary);
    animation: scroll-bounce 0.7s ease-in-out infinite alternate;
    transition: transform 0.3s ease, background-color var(--ease);
  }

  .scroll-cta:hover .scroll-arrow {
    background: var(--accent);
    animation-play-state: paused;
  }

  .scroll-cta[aria-expanded='true'] .scroll-arrow {
    animation: none;
    transform: rotate(180deg);
  }

  @keyframes scroll-bounce {
    from { transform: translateY(0); }
    to { transform: translateY(6px); }
  }

  .reveal-wrap {
    scroll-margin-top: var(--nav-h, 65px);
  }

  .section {
    scroll-margin-top: var(--nav-h, 65px);
  }

  .education-list {
    margin-top: 24px;
    padding-left: 5px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }

  .stack-list {
    display: flex;
    flex-direction: column;
    margin-top: 28px;
  }

  .stack-row {
    display: flex;
    gap: 28px;
    align-items: baseline;
    padding: 18px 12px;
    border-bottom: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition: background-color var(--ease);
  }

  .stack-row:hover {
    background: var(--surface);
  }

  .stack-row:last-child {
    border-bottom: none;
  }

  .stack-label {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    color: var(--primary);
    min-width: 200px;
    flex-shrink: 0;
  }

  .stack-items {
    color: var(--text);
    font-size: 15px;
  }

  @media (max-width: 640px) {
    .hero-intro {
      padding: 32px 0 20px;
    }
    .hero-intro h1 {
      font-size: 44px;
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .stack-row {
      flex-direction: column;
      gap: 4px;
    }
    .stack-label {
      min-width: auto;
    }
  }
</style>
