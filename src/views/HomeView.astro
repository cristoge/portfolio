---
import EducationItem from '../components/EducationItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getDictionary, projectDetailPath, projectLinkLabels, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const { repoLabel, demoLabel } = projectLinkLabels(lang);
const github = t.contact.links.find((l) => l.label === 'GitHub');
const greetingWords = t.hero.greeting.split(' ');
---

<section class="hero-intro">
  <div class="hero-intro-body">
    <div class="hero-main">
      <p class="eyebrow">{t.hero.kicker}</p>
      <h1>
        <em>{greetingWords.map((word, i) => <><span class="word"><span style={`--i:${i}`}>{word}</span></span>{' '}</>)}</em>
        <span class="word"><span style={`--i:${greetingWords.length}`}>{t.hero.name}</span></span>
      </h1>
    </div>
    <div class="hero-side">
      <p class="lead">{t.hero.tagline}</p>
      <div class="hero-actions">
        <a href={t.hero.ctaHref} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          {t.hero.cta} <span aria-hidden="true">↗</span>
        </a>
        {github && (
          <a href={github.href} class="arrow-link" target="_blank" rel="noopener noreferrer">
            GitHub <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
  </div>

  <button type="button" id="reveal-toggle" class="scroll-cta" aria-expanded="false" aria-controls="reveal-content">
    <span>{t.hero.exploreCta}</span>
    <span class="scroll-arrow" aria-hidden="true">↓</span>
  </button>
</section>

<div class="reveal-wrap" id="reveal-wrap">
  <div class="reveal-inner" id="reveal-content">
    <section class="section dark-panel" id="projects">
      <div class="section-head reveal">
        <span class="eyebrow">01</span>
        <div>
          <h2>{t.projects.heading}</h2>
          <p class="note">{t.projects.note}</p>
        </div>
      </div>
      <div class="projects-grid">
        {t.projects.items.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            stack={project.stack}
            detailHref={projectDetailPath(lang, project.slug)}
            repoHref={project.repoHref}
            demoHref={project.demoHref}
            image={project.image}
            repoLabel={repoLabel}
            demoLabel={demoLabel}
          />
        ))}
      </div>
    </section>

    <section class="section" id="education">
      <div class="section-head reveal">
        <span class="eyebrow">02</span>
        <h2>{t.education.heading}</h2>
      </div>
      <div class="education-list">
        {t.education.items.map((item) => (
          <EducationItem
            institution={item.institution}
            institutionHref={item.institutionHref}
            degree={item.degree}
            dates={item.dates}
            note={item.note}
            coursework={item.coursework}
            courseworkLabel={t.education.courseworkLabel}
          />
        ))}
      </div>
    </section>

    <section class="section" id="stack">
      <div class="section-head reveal">
        <span class="eyebrow">03</span>
        <h2>{t.stack.heading}</h2>
      </div>
      <div class="stack-list">
        {t.stack.groups.map((group, i) => (
          <div class="stack-row reveal">
            <span class="stack-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="stack-label">{group.label}</span>
            <span class="stack-items">{group.items.join(' · ')}</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</div>

<script>
  const toggle = document.getElementById('reveal-toggle');
  const wrap = document.getElementById('reveal-wrap');
  const STORAGE_KEY = 'home-revealed';

  const markRevealed = () => {
    try {
      sessionStorage.setItem(STORAGE_KEY, 'true');
    } catch {
      // ignore (private browsing / storage disabled)
    }
    document.documentElement.classList.add('home-revealed');
    toggle?.setAttribute('aria-expanded', 'true');
  };

  if (document.documentElement.classList.contains('home-revealed')) {
    toggle?.setAttribute('aria-expanded', 'true');
  }

  const hashTarget = window.location.hash && document.getElementById(window.location.hash.slice(1));
  const hasHashTarget = Boolean(wrap && hashTarget && wrap.contains(hashTarget));

  if (hasHashTarget) {
    markRevealed();
    requestAnimationFrame(() => hashTarget.scrollIntoView({ block: 'start' }));
  }

  toggle?.addEventListener('click', () => {
    markRevealed();
    wrap?.scrollIntoView({ block: 'start' });
  });
</script>

<style>
  :global(html[data-hero-lock]:not(.home-revealed)),
  :global(html[data-hero-lock]:not(.home-revealed) body) {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  :global(html[data-hero-lock]:not(.home-revealed) #reveal-wrap),
  :global(html[data-hero-lock]:not(.home-revealed) #site-footer) {
    display: none;
  }

  .hero-intro {
    height: calc(100dvh - var(--nav-h, 85px));
    max-height: calc(100dvh - var(--nav-h, 85px));
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 40px 0 28px;
    overflow: hidden;
  }

  /* Centrado vertical, pero el padding inferior lo sube un poco. */
  .hero-intro-body {
    margin: auto 0;
    padding-bottom: 14vh;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 0.55fr);
    align-items: start;
    gap: 56px;
  }

  .hero-intro h1 {
    margin-top: 28px;
    font-size: clamp(48px, 7.4vw, 112px);
    letter-spacing: -0.046em;
    line-height: 0.92;
  }

  .hero-intro h1 em {
    font-style: normal;
    color: var(--hero-muted);
  }

  /* Empieza a la altura del h1, no de la eyebrow. */
  .hero-side {
    margin-top: 44px;
  }

  .hero-side .lead {
    font-size: clamp(19px, 1.6vw, 23px);
    line-height: 1.4;
  }

  .hero-actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 32px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-main .eyebrow {
      animation: fade-up 0.7s var(--ease-out) 0.1s both;
    }
    .hero-main .eyebrow::before {
      transform-origin: left;
      animation: line-grow 0.7s var(--ease-out) both;
    }
    .hero-intro h1 .word > span {
      animation: word-up 0.9s var(--ease-out) both;
      animation-delay: calc(0.25s + var(--i) * 90ms);
    }
    .hero-side {
      animation: fade-up 0.9s var(--ease-out) 0.65s both;
    }
    .scroll-cta {
      animation: fade-up 0.9s var(--ease-out) 0.9s both;
    }
  }

  :global(html.home-revealed) .scroll-cta {
    display: none;
  }

  .scroll-cta {
    align-self: center;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 0 0 8px;
    background: none;
    border: 0;
    border-bottom: 1px solid;
    color: var(--ink);
    cursor: pointer;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .scroll-arrow {
    font-size: 19px;
    line-height: 1;
    transition: transform 0.2s;
  }

  .scroll-cta:hover .scroll-arrow {
    transform: translateY(4px);
  }

  .reveal-wrap {
    scroll-margin-top: var(--nav-h, 85px);
  }

  .section {
    scroll-margin-top: var(--nav-h, 85px);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }

  .stack-row {
    display: grid;
    grid-template-columns: 70px 220px minmax(0, 1fr);
    align-items: baseline;
    gap: 28px;
    padding: 26px 0;
    border-top: 1px solid var(--line-strong);
  }

  .stack-row:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .stack-num {
    font-size: 12px;
    color: var(--muted);
    transition: color 0.3s;
  }

  .stack-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .stack-items {
    font-size: clamp(17px, 1.5vw, 20px);
    font-weight: 500;
    letter-spacing: -0.024em;
    line-height: 1.25;
    transition: transform 0.4s var(--ease-out);
  }

  @media (hover: hover) {
    .stack-row:hover .stack-num {
      color: var(--ink);
    }
    .stack-row:hover .stack-items {
      transform: translateX(8px);
    }
  }

  @media (max-width: 900px) {
    .hero-intro-body {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .hero-side {
      margin-top: 0;
    }
    .stack-row {
      grid-template-columns: 35px 1fr;
      gap: 10px 16px;
    }
    .stack-items {
      grid-column: 2;
    }
  }

  @media (max-width: 640px) {
    .hero-intro {
      padding: 28px 0 20px;
    }
    .hero-intro h1 {
      font-size: clamp(44px, 11.5vw, 72px);
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .stack-row {
      grid-template-columns: 28px 1fr;
    }
  }
</style>
