---
import EducationItem from '../components/EducationItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getDictionary, projectDetailPath, projectLinkLabels, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const { repoLabel, demoLabel } = projectLinkLabels(lang);
const github = t.contact.links.find((l) => l.label === 'GitHub');
const greetingWords = t.hero.greeting.split(' ');
---

<section class="hero-intro">
  <div class="hero-intro-body">
    <div class="hero-main">
      <p class="eyebrow">{t.hero.kicker}</p>
      <h1>
        {greetingWords.map((word, i) => <><span class="word"><span style={`--i:${i}`}>{word}</span></span>{' '}</>)}
        <span class="squiggle">
          <span class="word"><span style={`--i:${greetingWords.length}`}>{t.hero.name}</span></span>
          <svg class="squiggle-line" viewBox="0 0 200 10" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 6 C 30 2, 60 9, 95 5 S 160 2, 198 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" pathLength="1" />
          </svg>
        </span>
      </h1>
    </div>
    <div class="hero-side">
      <p class="lead">{t.hero.tagline}</p>
      <div class="hero-actions">
        <a href={t.hero.ctaHref} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          {t.hero.cta} <span class="arrow" aria-hidden="true">→</span>
        </a>
        {github && (
          <a href={github.href} class="arrow-link" target="_blank" rel="noopener noreferrer">
            GitHub <span class="arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>
  </div>

  <button type="button" id="reveal-toggle" class="scroll-cta" aria-expanded="false" aria-controls="reveal-content">
    <span>{t.hero.exploreCta}</span>
    <span class="arrow arrow-down" aria-hidden="true">↓</span>
  </button>
</section>

<div class="reveal-wrap" id="reveal-wrap">
  <div class="reveal-inner" id="reveal-content">
    <section class="section" id="projects">
      <div class="section-head reveal">
        <div>
          <h2>{t.projects.heading}</h2>
          <p class="note">{t.projects.note}</p>
        </div>
      </div>
      <div class="projects-grid">
        {t.projects.items.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            stack={project.stack}
            detailHref={projectDetailPath(lang, project.slug)}
            repoHref={project.repoHref}
            demoHref={project.demoHref}
            image={project.image}
            repoLabel={repoLabel}
            demoLabel={demoLabel}
          />
        ))}
      </div>
    </section>

    <section class="section" id="education">
      <div class="section-head reveal">
        <h2>{t.education.heading}</h2>
      </div>
      <div class="education-list">
        {t.education.items.map((item) => (
          <EducationItem
            institution={item.institution}
            institutionHref={item.institutionHref}
            degree={item.degree}
            dates={item.dates}
            note={item.note}
            coursework={item.coursework}
            courseworkLabel={t.education.courseworkLabel}
            link={'link' in item ? item.link : undefined}
          />
        ))}
      </div>
    </section>

    <section class="section" id="stack">
      <div class="section-head reveal">
        <h2>{t.stack.heading}</h2>
      </div>
      <div class="stack-list">
        {t.stack.groups.map((group, i) => (
          <div class="stack-cell reveal">
            <span class="mono stack-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="stack-label">{group.label}</h3>
            <ul class="stack-items">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </div>
</div>

<script>
  const toggle = document.getElementById('reveal-toggle');
  const wrap = document.getElementById('reveal-wrap');
  const STORAGE_KEY = 'home-revealed';

  const markRevealed = () => {
    try {
      sessionStorage.setItem(STORAGE_KEY, 'true');
    } catch {
      // ignore (private browsing / storage disabled)
    }
    document.documentElement.classList.add('home-revealed');
    toggle?.setAttribute('aria-expanded', 'true');
  };

  if (document.documentElement.classList.contains('home-revealed')) {
    toggle?.setAttribute('aria-expanded', 'true');
  }

  const hashTarget = window.location.hash && document.getElementById(window.location.hash.slice(1));
  const hasHashTarget = Boolean(wrap && hashTarget && wrap.contains(hashTarget));

  if (hasHashTarget) {
    markRevealed();
    requestAnimationFrame(() => hashTarget.scrollIntoView({ block: 'start' }));
  }

  toggle?.addEventListener('click', () => {
    markRevealed();
    wrap?.scrollIntoView({ block: 'start' });
  });
</script>

<style>
  :global(html.js[data-hero-lock]:not(.home-revealed)),
  :global(html.js[data-hero-lock]:not(.home-revealed) body) {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  :global(html.js[data-hero-lock]:not(.home-revealed) #reveal-wrap),
  :global(html.js[data-hero-lock]:not(.home-revealed) #site-footer) {
    display: none;
  }

  .hero-intro {
    height: calc(100dvh - var(--nav-h, 60px));
    max-height: calc(100dvh - var(--nav-h, 60px));
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 24px 0 28px;
    overflow: hidden;
  }

  /* Portada alineada a la izquierda: etiqueta, titular grande, entradilla y botones. */
  .hero-intro-body {
    margin: auto 0;
    padding-bottom: 6vh;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .hero-intro h1 {
    max-width: 16ch;
    margin-top: 32px;
    font-size: var(--fs-display);
    letter-spacing: -0.02em;
    line-height: 1.06;
  }

  .hero-side .lead {
    max-width: 56ch;
  }

  .hero-actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-main .eyebrow {
      animation: fade-up 0.7s var(--ease-out) 0.1s both;
    }
    .hero-intro h1 .word > span {
      animation: word-up 0.9s var(--ease-out) both;
      animation-delay: calc(0.25s + var(--i) * 90ms);
    }
    .hero-intro .squiggle-line path {
      stroke-dasharray: 1;
      animation: draw 0.9s var(--ease-out) 0.9s both;
    }
    .hero-side {
      animation: fade-up 0.9s var(--ease-out) 0.65s both;
    }
    .scroll-cta {
      animation: fade-up 0.9s var(--ease-out) 0.9s both;
    }
  }

  :global(html.home-revealed) .scroll-cta {
    display: none;
  }

  .scroll-cta {
    align-self: center;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--copy);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .scroll-cta:hover {
    color: var(--accent);
  }

  .scroll-cta:hover .arrow-down {
    transform: translateY(3px);
  }

  .reveal-wrap,
  .section {
    scroll-margin-top: var(--nav-h, 60px);
  }

  /* Rejillas de 3 columnas: proyectos como tarjetas separadas, tecnologías con bordes compartidos. */
  .projects-grid,
  .stack-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .projects-grid {
    gap: 20px;
  }

  .projects-grid > :global(*) {
    border: 1px solid var(--line-strong);
  }

  .stack-list {
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }

  .stack-cell {
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .stack-cell {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 24px;
  }

  .stack-num {
    color: var(--accent);
  }

  .stack-items {
    margin: 4px 0 0;
    padding: 12px 0 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--line);
    color: var(--copy);
    font-size: var(--fs-sm);
  }

  .stack-items li {
    position: relative;
    padding-left: 18px;
  }

  /* Rombo pequeño como viñeta. */
  .stack-items li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border: 1px solid var(--muted);
    transform: rotate(45deg);
  }

  @media (max-width: 900px) {
    .projects-grid,
    .stack-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hero-intro {
      padding: 20px 0;
    }
    .projects-grid,
    .stack-list {
      grid-template-columns: 1fr;
    }
  }
</style>
