---
import EducationItem from '../components/EducationItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getDictionary, projectDetailPath, projectLinkLabels, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const { repoLabel, demoLabel } = projectLinkLabels(lang);
const github = t.contact.links.find((l) => l.label === 'GitHub');
const greetingWords = t.hero.greeting.split(' ');
---

<section class="hero-intro">
  <div class="hero-intro-body">
    <div class="hero-main">
      <p class="eyebrow">{t.hero.kicker}</p>
      <h1>
        <span class="hero-muted">{greetingWords.map((word, i) => <><span class="word"><span style={`--i:${i}`}>{word}</span></span>{' '}</>)}</span>
        <span class="word"><span style={`--i:${greetingWords.length}`}>{t.hero.name}</span></span>
      </h1>
    </div>
    <div class="hero-side">
      <p class="lead">{t.hero.tagline}</p>
      <div class="hero-actions">
        <a href={t.hero.ctaHref} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          {t.hero.cta} <span class="arrow" aria-hidden="true">→</span>
        </a>
        {github && (
          <a href={github.href} class="arrow-link" target="_blank" rel="noopener noreferrer">
            GitHub <span class="arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>
  </div>

  <button type="button" id="reveal-toggle" class="scroll-cta" aria-expanded="false" aria-controls="reveal-content">
    <span>{t.hero.exploreCta}</span>
    <span class="arrow arrow-down" aria-hidden="true">↓</span>
  </button>
</section>

<div class="reveal-wrap" id="reveal-wrap">
  <div class="reveal-inner" id="reveal-content">
    <section class="section" id="projects">
      <div class="section-head reveal">
        <div>
          <h2>{t.projects.heading}</h2>
          <p class="note">{t.projects.note}</p>
        </div>
      </div>
      <div class="projects-grid">
        {t.projects.items.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            stack={project.stack}
            detailHref={projectDetailPath(lang, project.slug)}
            repoHref={project.repoHref}
            demoHref={project.demoHref}
            image={project.image}
            repoLabel={repoLabel}
            demoLabel={demoLabel}
          />
        ))}
      </div>
    </section>

    <section class="section" id="education">
      <div class="section-head reveal">
        <h2>{t.education.heading}</h2>
      </div>
      <div class="education-list">
        {t.education.items.map((item) => (
          <EducationItem
            institution={item.institution}
            institutionHref={item.institutionHref}
            degree={item.degree}
            dates={item.dates}
            note={item.note}
            coursework={item.coursework}
            courseworkLabel={t.education.courseworkLabel}
            link={'link' in item ? item.link : undefined}
          />
        ))}
      </div>
    </section>

    <section class="section" id="stack">
      <div class="section-head reveal">
        <h2>{t.stack.heading}</h2>
      </div>
      <div class="stack-list">
        {t.stack.groups.map((group) => (
          <div class="stack-row card reveal">
            <span class="stack-label">{group.label}</span>
            <span class="stack-items">{group.items.join(' · ')}</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</div>

<script>
  const toggle = document.getElementById('reveal-toggle');
  const wrap = document.getElementById('reveal-wrap');
  const STORAGE_KEY = 'home-revealed';

  const markRevealed = () => {
    try {
      sessionStorage.setItem(STORAGE_KEY, 'true');
    } catch {
      // ignore (private browsing / storage disabled)
    }
    document.documentElement.classList.add('home-revealed');
    toggle?.setAttribute('aria-expanded', 'true');
  };

  if (document.documentElement.classList.contains('home-revealed')) {
    toggle?.setAttribute('aria-expanded', 'true');
  }

  const hashTarget = window.location.hash && document.getElementById(window.location.hash.slice(1));
  const hasHashTarget = Boolean(wrap && hashTarget && wrap.contains(hashTarget));

  if (hasHashTarget) {
    markRevealed();
    requestAnimationFrame(() => hashTarget.scrollIntoView({ block: 'start' }));
  }

  toggle?.addEventListener('click', () => {
    markRevealed();
    wrap?.scrollIntoView({ block: 'start' });
  });
</script>

<style>
  :global(html.js[data-hero-lock]:not(.home-revealed)),
  :global(html.js[data-hero-lock]:not(.home-revealed) body) {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  :global(html.js[data-hero-lock]:not(.home-revealed) #reveal-wrap),
  :global(html.js[data-hero-lock]:not(.home-revealed) #site-footer) {
    display: none;
  }

  .hero-intro {
    height: calc(100dvh - var(--nav-h, 66px));
    max-height: calc(100dvh - var(--nav-h, 66px));
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 24px 0 28px;
    overflow: hidden;
  }

  /* Portada centrada: etiqueta, titular enorme y debajo la frase con los botones. */
  .hero-intro-body {
    margin: auto 0;
    padding-bottom: 8vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
    text-align: center;
  }

  .hero-main {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-intro h1 {
    margin-top: 28px;
    font-size: var(--fs-display);
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .hero-muted {
    color: var(--hero-muted);
  }

  .hero-side {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-side .lead {
    max-width: 560px;
  }

  .hero-actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-main .eyebrow {
      animation: fade-up 0.7s var(--ease-out) 0.1s both;
    }
    .hero-intro h1 .word > span {
      animation: word-up 0.9s var(--ease-out) both;
      animation-delay: calc(0.25s + var(--i) * 90ms);
    }
    .hero-side {
      animation: fade-up 0.9s var(--ease-out) 0.65s both;
    }
    .scroll-cta {
      animation: fade-up 0.9s var(--ease-out) 0.9s both;
    }
  }

  :global(html.home-revealed) .scroll-cta {
    display: none;
  }

  .scroll-cta {
    align-self: center;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 20px;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
    font-size: var(--fs-sm);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .scroll-cta:hover .arrow-down {
    transform: translateY(4px);
  }

  .reveal-wrap,
  .section {
    scroll-margin-top: var(--nav-h, 66px);
  }

  /* Dos columnas desplazadas: la segunda columna empieza más abajo. */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 80px clamp(40px, 8vw, 140px);
  }

  .projects-grid > :global(:nth-child(even)) {
    margin-top: 200px;
  }

  .stack-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }

  .stack-row {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    transition: border-color 0.2s;
  }

  .stack-row:hover {
    border-color: var(--ink);
  }

  .stack-label {
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .stack-items {
    font-size: var(--fs-read);
    font-weight: 500;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .projects-grid > :global(:nth-child(even)) {
      margin-top: 0;
    }
  }

  @media (max-width: 640px) {
    .hero-intro {
      padding: 20px 0 20px;
    }
    .stack-list {
      grid-template-columns: 1fr;
    }
  }
</style>
