---
import { getDictionary, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

type InlineLink = { text: string; href: string };

// Parte un párrafo en trozos de texto y enlaces, enlazando cada aparición de los textos indicados.
function linkify(paragraph: string, links: readonly InlineLink[] = []): (string | InlineLink)[] {
  const parts: (string | InlineLink)[] = [];
  let rest = paragraph;
  while (rest) {
    let next: { index: number; link: InlineLink } | undefined;
    for (const link of links) {
      const index = rest.indexOf(link.text);
      if (index !== -1 && (!next || index < next.index)) next = { index, link };
    }
    if (!next) {
      parts.push(rest);
      break;
    }
    if (next.index > 0) parts.push(rest.slice(0, next.index));
    parts.push(next.link);
    rest = rest.slice(next.index + next.link.text.length);
  }
  return parts;
}
---

<section class="personal">
  <header class="personal-intro">
    <p class="eyebrow">{t.personal.kicker}</p>
    <h1>{t.personal.heading}</h1>
    <div class="personal-body">
      {t.personal.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <dl class="facts">
      {t.personal.facts.map((fact) => (
        <div class="fact">
          <dt class="mono">{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </header>

  <div class="entries">
  {t.personal.sections.map((entry) => (
    <article class="entry reveal">
      <h2 class="entry-title">{entry.title}</h2>
      <div class="entry-content">
        {entry.body.map((paragraph) => (
          <p>
            {linkify(paragraph, 'inlineLinks' in entry ? entry.inlineLinks : []).map((part) =>
              typeof part === 'string' ? (
                part
              ) : (
                <a class="inline-link" href={part.href} target="_blank" rel="noopener noreferrer">{part.text}</a>
              ),
            )}
          </p>
        ))}
        {entry.note && <p class="entry-note">{entry.note}</p>}
        {entry.link && (
          <a class="entry-link arrow-link" href={entry.link.href} target="_blank" rel="noopener noreferrer">
            {entry.link.label} <span class="arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>
      <figure class="entry-media">
        <div class="photo-frame">
          {entry.image && <img src={entry.image} alt={entry.title} loading="lazy" />}
        </div>
        {entry.caption && <figcaption class="mono entry-caption">{entry.caption}</figcaption>}
      </figure>
    </article>
  ))}
  </div>
</section>

<style>
  .personal {
    padding: var(--page-top) 0 clamp(70px, 8vw, 120px);
  }

  /* Introducción a la izquierda y ficha a la derecha, en la misma columna que las fotos. */
  .personal-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    grid-template-areas:
      'kicker .'
      'title .'
      'body facts';
    align-items: start;
    column-gap: 32px;
    padding-bottom: var(--intro-gap);
  }

  .personal-intro .eyebrow {
    grid-area: kicker;
    justify-self: start;
  }

  .personal-intro h1 {
    grid-area: title;
    margin-top: 24px;
  }

  .personal-body {
    grid-area: body;
    margin-top: 24px;
    max-width: 680px;
    color: var(--copy);
    font-size: var(--fs-md);
    line-height: 1.65;
  }

  .personal-body p + p {
    margin-top: 14px;
  }

  /* Ficha: etiqueta en mono a la izquierda y valor a la derecha, filas separadas por líneas. */
  .facts {
    grid-area: facts;
    margin: 24px 0 0;
    border: 1px solid var(--line-strong);
  }

  .fact {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 18px;
  }

  .fact + .fact {
    border-top: 1px solid var(--line);
  }

  .fact dt {
    padding-top: 3px;
    color: var(--muted);
  }

  .fact dd {
    margin: 0;
    color: var(--ink);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .personal-intro > * {
      animation: fade-up 0.9s var(--ease-out) both;
    }
    .personal-intro h1 {
      animation-delay: 0.15s;
    }
    .personal-intro .personal-body {
      animation-delay: 0.3s;
    }
    .personal-intro .facts {
      animation-delay: 0.45s;
    }
  }

  /* Filas: texto alineado con la introducción y foto pequeña a la derecha,
     alineada con el primer párrafo y no con el título. */
  .entries {
    border-bottom: 1px solid var(--line-strong);
  }

  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    grid-template-areas:
      'title .'
      'content photo';
    align-items: start;
    gap: 20px 32px;
    padding: 40px 0;
    border-top: 1px solid var(--line-strong);
  }

  .entry-content {
    grid-area: content;
    max-width: 680px;
  }

  .entry-title {
    grid-area: title;
    margin: 0;
    font-size: var(--fs-h2);
  }

  .entry-content p {
    color: var(--copy);
    font-size: var(--fs-read);
    line-height: 1.65;
  }

  .entry-content p + p {
    margin-top: 14px;
  }

  .inline-link {
    color: var(--accent);
    text-decoration: underline 1px;
    text-underline-offset: 4px;
  }

  .inline-link:hover {
    text-decoration-thickness: 2px;
  }

  .entry-content .entry-note {
    margin-top: 24px;
    padding: 14px 18px;
    border-left: 2px solid var(--accent);
    color: var(--ink);
    font-size: var(--fs-base);
  }

  .entry-link {
    margin-top: 20px;
  }

  .entry-media {
    grid-area: photo;
    margin: 0;
  }

  .photo-frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--ink);
    background: var(--surface);
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .entry:hover .photo-frame img {
    transform: scale(1.03);
  }

  /* Pie de foto en mono, como la documentación de un caso. */
  .entry-caption {
    margin-top: 10px;
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .personal-intro,
    .entry {
      grid-template-columns: minmax(0, 1fr) minmax(0, 280px);
    }
  }

  @media (max-width: 760px) {
    .entry {
      grid-template-columns: 1fr;
      grid-template-areas: 'title' 'content' 'photo';
      gap: 20px;
      padding: 32px 0;
    }
    .personal-intro {
      grid-template-columns: 1fr;
      grid-template-areas: 'kicker' 'title' 'body' 'facts';
    }
    .facts {
      margin-top: 32px;
    }
  }
</style>
