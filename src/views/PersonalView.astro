---
import { getDictionary, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

type InlineLink = { text: string; href: string };

// Parte un párrafo en trozos de texto y enlaces, enlazando cada aparición de los textos indicados.
function linkify(paragraph: string, links: readonly InlineLink[] = []): (string | InlineLink)[] {
  const parts: (string | InlineLink)[] = [];
  let rest = paragraph;
  while (rest) {
    let next: { index: number; link: InlineLink } | undefined;
    for (const link of links) {
      const index = rest.indexOf(link.text);
      if (index !== -1 && (!next || index < next.index)) next = { index, link };
    }
    if (!next) {
      parts.push(rest);
      break;
    }
    if (next.index > 0) parts.push(rest.slice(0, next.index));
    parts.push(next.link);
    rest = rest.slice(next.index + next.link.text.length);
  }
  return parts;
}
---

<section class="personal">
  <header class="personal-intro">
    <p class="eyebrow">{t.personal.kicker}</p>
    <h1>{t.personal.heading}</h1>
    <div class="personal-body">
      {t.personal.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </header>

  {t.personal.sections.map((entry, i) => (
    <article class="entry reveal">
      <div class="entry-content">
        <span class="entry-num">{String(i + 1).padStart(2, '0')}</span>
        <h2 class="entry-title">{entry.title}</h2>
        {entry.body.map((paragraph) => (
          <p>
            {linkify(paragraph, 'inlineLinks' in entry ? entry.inlineLinks : []).map((part) =>
              typeof part === 'string' ? (
                part
              ) : (
                <a class="inline-link" href={part.href} target="_blank" rel="noopener noreferrer">{part.text}</a>
              ),
            )}
          </p>
        ))}
        {entry.note && <p class="entry-note">{entry.note}</p>}
        {entry.link && (
          <a class="entry-link arrow-link" href={entry.link.href} target="_blank" rel="noopener noreferrer">
            {entry.link.label} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}
      </div>
      <div class="photo-frame">
        {entry.image && <img src={entry.image} alt={entry.title} loading="lazy" />}
      </div>
    </article>
  ))}
</section>

<style>
  .personal {
    padding: 90px 0 clamp(70px, 8vw, 120px);
  }

  .personal-intro {
    padding-bottom: 80px;
  }

  .personal-intro h1 {
    margin-top: 24px;
  }

  .personal-body {
    margin-top: 24px;
    max-width: 680px;
    color: var(--copy);
    font-size: clamp(17px, 1.3vw, 19px);
    line-height: 1.65;
  }

  .personal-body p + p {
    margin-top: 14px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .personal-intro > * {
      animation: fade-up 0.9s var(--ease-out) both;
    }
    .personal-intro h1 {
      animation-delay: 0.15s;
    }
    .personal-intro .personal-body {
      animation-delay: 0.3s;
    }
  }

  .entry {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
    padding: 64px 0;
    border-top: 1px solid var(--line-strong);
  }

  .entry:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .entry:nth-of-type(even) .photo-frame {
    order: -1;
  }

  .entry-num {
    display: block;
    margin-bottom: 20px;
    font-size: 12px;
    color: var(--muted);
  }

  .entry-title {
    margin: 0 0 20px;
    font-size: clamp(28px, 3.4vw, 48px);
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .entry-content p {
    color: var(--copy);
    font-size: 17px;
    line-height: 1.65;
  }

  .entry-content p + p {
    margin-top: 14px;
  }

  .inline-link {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline 1px;
    text-underline-offset: 3px;
  }

  .inline-link:hover {
    color: var(--muted);
  }

  .entry-content .entry-note {
    margin-top: 24px;
    padding: 14px 18px;
    border-left: 2px solid var(--ink);
    color: var(--ink);
    font-size: 15px;
  }

  .entry-link {
    margin-top: 28px;
  }

  .photo-frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--line);
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.6s var(--ease-in-out), transform 0.8s var(--ease-out);
  }

  .entry:hover .photo-frame img {
    filter: none;
    transform: scale(1.03);
  }

  @media (max-width: 760px) {
    .personal {
      padding-top: 70px;
    }
    .personal-intro {
      padding-bottom: 55px;
    }
    .entry {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 44px 0;
    }
    .entry:nth-of-type(even) .photo-frame {
      order: 0;
    }
    .photo-frame img {
      filter: none;
    }
  }
</style>
