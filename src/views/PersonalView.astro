---
import { getDictionary, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section class="personal-placeholder">
  <p class="kicker">{t.personal.kicker}</p>
  <h1>{t.personal.heading}</h1>
  <p class="personal-body">{t.personal.body}</p>
  <div class="photo-grid" aria-hidden="true">
    <div class="photo-frame"></div>
    <div class="photo-frame"></div>
    <div class="photo-frame"></div>
  </div>
</section>

<style>
  .personal-placeholder {
    padding: 72px 0 72px 20px;
  }

  .personal-body {
    margin-top: 20px;
    max-width: 52ch;
    color: var(--text-soft);
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 44px;
  }

  .photo-frame {
    aspect-ratio: 1;
    background: var(--surface);
    border-radius: var(--radius-md);
    transition: box-shadow var(--ease);
  }

  .photo-frame:hover {
    box-shadow: var(--shadow-inset);
  }

  @media (max-width: 480px) {
    .personal-placeholder {
      padding-left: 16px;
    }
    .photo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
