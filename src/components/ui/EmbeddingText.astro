---
interface Props { text: string }
const { text } = Astro.props;
---

<span class="embedding-text" data-scramble-text={text}>
  <span class="embedding-source">{text}</span>
  <span class="embedding-vector" aria-hidden="true"></span>
</span>

<style>
  .embedding-text { position: relative; display: inline-block; max-width: 100%; vertical-align: baseline; }
  /* The real text always reserves its exact space and accessible name. */
  .embedding-vector {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    font: inherit;
    letter-spacing: inherit;
  }
  .embedding-vector :global(.embedding-encoded) {
    font-family: var(--font-mono);
    font-size: 0.52em;
    font-weight: 400;
    letter-spacing: -0.025em;
    color: var(--accent);
  }
  .embedding-vector :global(.embedding-decoded) { color: var(--ink); }
</style>
