---
import DrawRule from './DrawRule.astro';
import EmbeddingText from './EmbeddingText.astro';
// Cabecera de sección: título y, opcionalmente, una nota debajo.
interface Props {
  heading: string;
  note?: string;
  reveal?: boolean;
}

const { heading, note, reveal = true } = Astro.props;
---

<div class="section-head">
  <div>
    <h2 data-text-reveal={reveal ? '' : undefined}><EmbeddingText text={heading} /></h2>
    <DrawRule />
    {note && <p class="note" data-text-reveal={reveal ? '' : undefined}>{note}</p>}
  </div>
</div>
