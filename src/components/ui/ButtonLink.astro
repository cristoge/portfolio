---
import { externalLink } from '../../lib/links';

// Enlace con aspecto de botón recto (estilos `.btn` de global.css).
interface Props {
  href: string;
  variant?: 'primary' | 'outline';
  external?: boolean;
}

const { href, variant = 'primary', external = false } = Astro.props;
---

<a href={href} class:list={['btn', `btn-${variant}`]} {...(external ? externalLink : {})}>
  <slot /> <span class="arrow" aria-hidden="true">→</span>
</a>
