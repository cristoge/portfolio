---
interface Props {
  title: string;
  description: string;
  stack: readonly string[];
  detailHref: string;
  repoHref: string;
  demoHref?: string;
  image?: string;
  repoLabel: string;
  demoLabel: string;
}

const { title, description, stack, detailHref, repoHref, demoHref, image, repoLabel, demoLabel } = Astro.props;
---

<article class="project-card reveal">
  <div class="project-image" aria-hidden="true">
    {image ? <img src={image} alt="" loading="lazy" /> : 'IMG'}
  </div>
  <h3 class="project-title">
    <a href={detailHref} class="project-title-link">{title}</a>
  </h3>
  <p class="project-description">{description}</p>
  <div class="pill-row project-stack">
    {stack.map((tech) => <span class="pill">{tech}</span>)}
  </div>
  <div class="project-links">
    <a href={repoHref} class="project-link" target="_blank" rel="noopener noreferrer">
      {repoLabel} <span class="project-link-arrow" aria-hidden="true">↗</span>
    </a>
    {demoHref && (
      <a href={demoHref} class="project-link" target="_blank" rel="noopener noreferrer">
        {demoLabel} <span class="project-link-arrow" aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</article>

<style>
  /* Each card spans 5 rows of the parent grid (image, title, description,
     stack, links) via subgrid, so those rows line up across cards even when
     the text or the number of tags differs. */
  .project-card {
    isolation: isolate;
    position: relative;
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 5;
    row-gap: 18px;
    padding: 26px;
    border: 1px solid var(--panel-line);
    transition: color 0.3s;
  }

  /* El fondo claro sube desde abajo e invierte la tarjeta. */
  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--panel-hover);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.45s var(--ease-in-out);
  }

  .project-card:hover {
    color: var(--panel-hover-ink);
  }

  .project-card:hover::before {
    transform: none;
  }

  .project-image {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--panel-muted);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.45s var(--ease-in-out), transform 0.6s var(--ease-out);
  }

  .project-card:hover .project-image img {
    filter: none;
    transform: scale(1.03);
  }

  .project-title {
    font-size: clamp(21px, 1.9vw, 26px);
    letter-spacing: -0.033em;
    line-height: 1.08;
  }

  .project-card:hover .project-title-link {
    text-decoration: underline 1px;
    text-underline-offset: 0.12em;
  }

  /* El enlace del título cubre toda la tarjeta; los enlaces de abajo quedan por encima. */
  .project-title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-title-link:focus-visible {
    outline: none;
  }

  .project-card:has(.project-title-link:focus-visible) {
    outline: 2px solid var(--panel-ink);
    outline-offset: 4px;
  }

  .project-description {
    font-size: 15px;
    line-height: 1.55;
    color: var(--panel-muted);
    transition: color 0.3s;
  }

  .project-card:hover .project-description {
    color: var(--panel-hover-muted);
  }

  .project-stack {
    align-content: start;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    padding-top: 6px;
  }

  .project-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .project-link-arrow {
    font-size: 16px;
    line-height: 1;
    transition: transform 0.2s;
  }

  .project-link:hover .project-link-arrow {
    transform: translate(2px, -2px);
  }
</style>
