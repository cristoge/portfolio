---
interface Props {
  title: string;
  description: string;
  stack: readonly string[];
  detailHref: string;
  repoHref: string;
  demoHref?: string;
  image?: string;
  detailLabel: string;
  repoLabel: string;
  demoLabel: string;
}

const { title, description, stack, detailHref, repoHref, demoHref, image, detailLabel, repoLabel, demoLabel } =
  Astro.props;
---

<article class="project-card card">
  <a href={detailHref} class="project-image" aria-hidden="true" tabindex="-1">
    {image ? <img src={image} alt="" loading="lazy" /> : 'IMG'}
  </a>
  <h3 class="project-title">
    <a href={detailHref} class="project-title-link">{title}</a>
  </h3>
  <p class="project-description">{description}</p>
  <div class="pill-row project-stack">
    {stack.map((tech) => <span class="pill">{tech}</span>)}
  </div>
  <div class="project-links">
    <a href={detailHref} class="project-link">
      {detailLabel}
      <svg class="project-link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="13 5 20 12 13 19"/></svg>
    </a>
    <a href={repoHref} class="project-link">
      {repoLabel}
      <svg class="project-link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="13 5 20 12 13 19"/></svg>
    </a>
    {demoHref && (
      <a href={demoHref} class="project-link">
        {demoLabel}
        <svg class="project-link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="13 5 20 12 13 19"/></svg>
      </a>
    )}
  </div>
</article>

<style>
  /* Each card spans 5 rows of the parent grid (image, title, description,
     stack, links) via subgrid, so those rows line up across cards even when
     the text or the number of tags differs. */
  .project-card {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 5;
    row-gap: 14px;
    background: var(--surface);
  }

  .project-card:hover {
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .project-image {
    aspect-ratio: 16 / 9;
    background: var(--bg);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--grey);
    text-decoration: none;
    overflow: hidden;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-card:hover .project-title-link {
    color: var(--accent);
  }

  .project-title {
    margin: 0;
    font-family: var(--font-display);
    font-size-adjust: none;
    font-size: 24px;
    font-weight: 300;
  }

  .project-title-link {
    text-decoration: none;
    color: inherit;
  }

  .project-title-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .project-description {
    color: var(--text-soft);
    font-size: 14px;
  }

  .project-stack {
    align-content: start;
  }

  .project-stack .pill {
    background: var(--bg);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 4px;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    color: var(--primary);
    text-decoration: none;
  }

  .project-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-link-arrow {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    transition: transform var(--ease);
  }

  .project-link:hover .project-link-arrow {
    transform: translateX(3px);
  }
</style>
