---
interface Props {
  title: string;
  description: string;
  stack: readonly string[];
  detailHref: string;
  repoHref: string;
  demoHref?: string;
  image?: string;
  repoLabel: string;
  demoLabel: string;
}

const { title, description, stack, detailHref, repoHref, demoHref, image, repoLabel, demoLabel } = Astro.props;
---

<article class="project-card reveal">
  <div class="project-image card" aria-hidden="true">
    {image ? <img src={image} alt="" loading="lazy" /> : 'IMG'}
  </div>
  <h3 class="project-title">
    <a href={detailHref} class="project-title-link">{title}</a>
  </h3>
  <p class="project-description">{description}</p>
  <div class="pill-row">
    {stack.map((tech) => <span class="pill">{tech}</span>)}
  </div>
  <div class="project-links">
    <a href={repoHref} class="btn btn-primary project-link" target="_blank" rel="noopener noreferrer">
      {repoLabel} <span class="arrow" aria-hidden="true">→</span>
    </a>
    {demoHref && (
      <a href={demoHref} class="btn btn-outline project-link" target="_blank" rel="noopener noreferrer">
        {demoLabel} <span class="arrow" aria-hidden="true">→</span>
      </a>
    )}
  </div>
</article>

<style>
  /* La imagen va en una tarjeta redondeada; el texto queda debajo, fuera de ella. */
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .project-image {
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 16px;
    font-size: var(--fs-2xs);
    font-weight: 800;
    color: var(--muted);
    transition: border-color 0.3s;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .project-card:hover .project-image {
    border-color: var(--line-strong);
  }

  .project-card:hover .project-image img {
    transform: scale(1.03);
  }

  .project-title {
    font-size: var(--fs-h3);
  }

  .project-card:hover .project-title-link {
    text-decoration: underline 3px;
    text-underline-offset: 0.12em;
  }

  /* El enlace del título cubre toda la tarjeta; los botones de abajo quedan por encima. */
  .project-title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-title-link:focus-visible {
    outline: none;
  }

  .project-card:has(.project-title-link:focus-visible) .project-image {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  .project-description {
    color: var(--copy);
    font-size: var(--fs-base);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .project-link {
    position: relative;
    z-index: 1;
  }
</style>
