---
interface Props {
  title: string;
  description: string;
  stack: readonly string[];
  detailHref: string;
  repoHref: string;
  demoHref?: string;
  image?: string;
  repoLabel: string;
  demoLabel: string;
}

const { title, description, stack, detailHref, repoHref, demoHref, image, repoLabel, demoLabel } = Astro.props;
---

<article class="project-card reveal">
  <div class="project-image" aria-hidden="true">
    {image ? <img src={image} alt="" loading="lazy" /> : 'IMG'}
  </div>
  <div class="project-body">
    <h3 class="project-title">
      <a href={detailHref} class="project-title-link">{title}</a>
    </h3>
    <p class="project-description">{description}</p>
    <div class="pill-row">
      {stack.map((tech) => <span class="pill">{tech}</span>)}
    </div>
    <div class="project-links">
      <a href={repoHref} class="arrow-link project-link" target="_blank" rel="noopener noreferrer">
        {repoLabel} <span class="arrow" aria-hidden="true">→</span>
      </a>
      {demoHref && (
        <a href={demoHref} class="arrow-link project-link" target="_blank" rel="noopener noreferrer">
          {demoLabel} <span class="arrow" aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  /* Celda de la rejilla: imagen arriba y el texto debajo, separados por líneas finas. */
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--page);
    transition: background-color 0.2s;
  }

  .project-card:hover {
    background: var(--surface);
  }

  .project-image {
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-bottom: 1px solid var(--line-strong);
    background: var(--field);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .project-card:hover .project-image img {
    transform: scale(1.03);
  }

  .project-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
  }

  .project-card:hover .project-title-link {
    color: var(--accent);
  }

  /* El enlace del título cubre toda la tarjeta; los enlaces de abajo quedan por encima. */
  .project-title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-title-link:focus-visible {
    outline: none;
  }

  .project-card:has(.project-title-link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .project-description {
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--copy);
    font-size: var(--fs-sm);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin-top: auto;
  }

  .project-link {
    position: relative;
    z-index: 1;
  }
</style>
