---
interface Props {
  institution: string;
  institutionHref?: string;
  degree: string;
  dates: string;
  note: string;
  coursework?: readonly string[];
  courseworkLabel?: string;
  link?: { label: string; href: string };
}

const { institution, institutionHref, degree, dates, note, coursework, courseworkLabel, link } = Astro.props;
---

<div class="education-item card reveal">
  <div class="education-aside">
    <span class="education-dates">{dates}</span>
    {institutionHref ? (
      <a class="education-institution" href={institutionHref} target="_blank" rel="noopener noreferrer">
        {institution} <span class="arrow" aria-hidden="true">→</span>
      </a>
    ) : (
      <span class="education-institution">{institution}</span>
    )}
  </div>
  <div class="education-main">
    <h3 class="education-degree">{degree}</h3>
    {note && <p class="education-note">{note}</p>}
    {coursework && coursework.length > 0 && (
      <p class="education-coursework">
        <span class="education-label">{courseworkLabel}</span>
        {coursework.join(', ')}
      </p>
    )}
    {link && (
      <a class="education-link arrow-link" href={link.href} target="_blank" rel="noopener noreferrer">
        {link.label} <span class="arrow" aria-hidden="true">→</span>
      </a>
    )}
  </div>
</div>

<style>
  /* Tarjeta redondeada: fecha y centro a la izquierda, contenido de 720px pegado a la derecha. */
  .education-item {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    align-items: start;
    gap: 40px;
    padding: 36px;
    transition: border-color 0.2s;
  }

  .education-item + .education-item {
    margin-top: 16px;
  }

  .education-item:hover {
    border-color: var(--ink);
  }

  .education-aside {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
  }

  .education-dates {
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .education-institution {
    align-self: flex-start;
    font-size: var(--fs-sm);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  a.education-institution {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-block: 11px;
    margin-block: -11px;
  }

  a.education-institution:hover {
    text-decoration: underline 2px;
    text-underline-offset: 4px;
  }

  .education-main {
    justify-self: end;
    width: 100%;
    max-width: 720px;
  }

  .education-degree {
    font-size: var(--fs-h3);
  }

  .education-note,
  .education-coursework {
    margin-top: 14px;
    color: var(--copy);
    font-size: var(--fs-base);
  }

  .education-coursework {
    margin-top: 18px;
    font-size: var(--fs-base);
  }

  .education-link {
    margin-top: 24px;
  }

  .education-label {
    display: block;
    margin-bottom: 4px;
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .education-item {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 26px;
    }
    .education-main {
      justify-self: stretch;
      max-width: none;
    }
    .education-aside {
      flex-direction: row;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 8px 14px;
      padding-top: 0;
    }
    .education-institution {
      align-self: auto;
    }
  }
</style>
