---
interface Props {
  institution: string;
  institutionHref?: string;
  degree: string;
  dates: string;
  note: string;
  coursework?: string[];
  courseworkLabel?: string;
}

const { institution, institutionHref, degree, dates, note, coursework, courseworkLabel } = Astro.props;
---

<div class="education-item reveal">
  <div class="education-aside">
    <span class="education-dates">{dates}</span>
    {institutionHref ? (
      <a class="education-institution" href={institutionHref} target="_blank" rel="noopener noreferrer">
        {institution} <span class="education-institution-arrow" aria-hidden="true">↗</span>
      </a>
    ) : (
      <span class="education-institution">{institution}</span>
    )}
  </div>
  <div class="education-main">
    <h3 class="education-degree">{degree}</h3>
    {note && <p class="education-note">{note}</p>}
    {coursework && coursework.length > 0 && (
      <p class="education-coursework">
        <span class="education-label">{courseworkLabel}</span>
        {coursework.join(', ')}
      </p>
    )}
  </div>
</div>

<style>
  /* Columna estrecha con fecha y centro; el contenido se lee de arriba abajo a la derecha. */
  .education-item {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    align-items: start;
    gap: 40px;
    padding: 32px 0 36px;
    border-top: 1px solid var(--line-strong);
  }

  .education-item:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .education-aside {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 6px;
  }

  .education-dates {
    font-size: 12px;
    color: var(--muted);
    transition: color 0.3s;
  }

  .education-institution {
    align-self: flex-start;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  a.education-institution {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-bottom: 3px;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.35s var(--ease-out);
  }

  a.education-institution:hover {
    background-size: 100% 1px;
  }

  .education-institution-arrow {
    font-size: 13px;
    letter-spacing: 0;
    transition: transform 0.2s;
  }

  a.education-institution:hover .education-institution-arrow {
    transform: translate(2px, -2px);
  }

  /* Bloque de 720px pegado al borde derecho; el texto sigue alineado a la izquierda. */
  .education-main {
    justify-self: end;
    width: 100%;
    max-width: 720px;
  }

  .education-degree {
    font-size: clamp(20px, 1.9vw, 26px);
    letter-spacing: -0.025em;
    line-height: 1.2;
    transition: transform 0.4s var(--ease-out);
  }

  @media (hover: hover) {
    .education-item:hover .education-dates {
      color: var(--ink);
    }
    .education-item:hover .education-degree {
      transform: translateX(8px);
    }
  }

  .education-note,
  .education-coursework {
    margin-top: 12px;
    color: var(--copy);
    font-size: 16px;
  }

  .education-coursework {
    margin-top: 18px;
    font-size: 15px;
  }

  .education-label {
    display: block;
    margin-bottom: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .education-item {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 26px 0 30px;
    }
    .education-main {
      justify-self: stretch;
      max-width: none;
    }
    .education-aside {
      flex-direction: row;
      align-items: baseline;
      gap: 14px;
      padding-top: 0;
    }
    .education-institution {
      align-self: auto;
    }
  }
</style>
