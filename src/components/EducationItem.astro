---
interface Props {
  institution: string;
  degree: string;
  dates: string;
  note: string;
  grade?: string;
  coursework?: string[];
  gradeLabel?: string;
  courseworkLabel?: string;
}

const { institution, degree, dates, note, grade, coursework, gradeLabel, courseworkLabel } = Astro.props;
---

<div class="education-item">
  <div class="education-header">
    <h3 class="education-institution">{institution}</h3>
    <span class="education-dates">{dates}</span>
  </div>
  <p class="education-degree">{degree}</p>
  {note && <p class="education-note">{note}</p>}
  {grade && (
    <p class="education-detail">
      <strong>{gradeLabel}:</strong> {grade}
    </p>
  )}
  {coursework && coursework.length > 0 && (
    <p class="education-detail">
      <strong>{courseworkLabel}:</strong> {coursework.join(', ')}
    </p>
  )}
</div>

<style>
  .education-item {
    position: relative;
    padding: 4px 0 4px 22px;
    border-left: 1px solid var(--grey);
    margin-bottom: 32px;
  }
  .education-item::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 10px;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--primary);
  }
  .education-item:last-child {
    margin-bottom: 0;
  }

  .education-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .education-institution {
    margin: 0;
    font-size: 19px;
  }

  .education-dates {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--primary);
    background: var(--surface);
    border-radius: var(--radius-sm);
    padding: 3px 8px;
    white-space: nowrap;
  }

  .education-degree {
    color: var(--primary);
    font-size: 15px;
    font-weight: 500;
    margin-top: 6px;
  }

  .education-note {
    color: var(--text-soft);
    font-size: 14px;
    margin-top: 6px;
  }

  .education-detail {
    color: var(--text-soft);
    font-size: 14px;
    margin-top: 4px;
  }
</style>
