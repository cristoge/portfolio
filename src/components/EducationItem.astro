---
interface Props {
  institution: string;
  degree: string;
  dates: string;
  note: string;
}

const { institution, degree, dates, note } = Astro.props;
---

<div class="education-item">
  <div class="education-header">
    <h3 class="education-institution">{institution}</h3>
    <span class="education-dates">{dates}</span>
  </div>
  <p class="education-degree">{degree}</p>
  {note && <p class="education-note">{note}</p>}
</div>

<style>
  .education-item {
    padding-left: 14px;
    border-left: 2px solid var(--line);
    margin-bottom: 22px;
  }
  .education-item:last-child {
    margin-bottom: 0;
  }

  .education-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .education-institution {
    margin: 0;
    font-size: 18px;
  }

  .education-dates {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .education-degree {
    color: var(--forest);
    font-size: 15px;
    margin-top: 4px;
  }

  .education-note {
    color: var(--ink-soft);
    font-size: 14px;
    margin-top: 6px;
  }
</style>
