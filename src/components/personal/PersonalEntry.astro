---
import EmbeddingText from '../ui/EmbeddingText.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import type { PersonalSection } from '../../i18n/types';
import { externalLink } from '../../lib/links';
import { linkify } from '../../lib/linkify';

interface Props {
  entry: PersonalSection;
  reverse: boolean;
}

const { entry, reverse } = Astro.props;
---

<article class:list={['entry', { 'entry--reverse': reverse }]}>
  <div class="entry-content">
    <p class="eyebrow entry-kicker" data-text-reveal>{entry.kicker}</p>
    <h2 data-text-reveal><EmbeddingText text={entry.title} /></h2>
    {entry.body.map((paragraph) => (
      <p data-text-reveal>
        {linkify(paragraph, entry.inlineLinks).map((part) =>
          typeof part === 'string' ? part : (
            <a class="inline-link animated-underline" href={part.href} {...externalLink}>{part.text}</a>
          ),
        )}
      </p>
    ))}
    {entry.note && <p class="entry-note" data-text-reveal>{entry.note}</p>}
    {entry.link && <ArrowLink href={entry.link.href} class="entry-link" external>{entry.link.label}</ArrowLink>}
  </div>
  <figure class="entry-media">
    <div class="photo-frame" data-personal-photo>
      <img src={entry.image} alt={entry.imageAlt} loading="lazy" />
      <span class="photo-trace" data-personal-trace aria-hidden="true"></span>
    </div>
    {entry.caption && <figcaption class="mono entry-caption">{entry.caption}</figcaption>}
  </figure>
</article>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const played = new WeakSet<Element>();
  let media: ReturnType<typeof gsap.matchMedia> | undefined;

  function mount() {
    if (media) return;
    media = gsap.matchMedia();
    media.add('(prefers-reduced-motion: no-preference)', () => {
      for (const photo of document.querySelectorAll('[data-personal-photo]')) {
        if (played.has(photo)) continue;
        const trace = photo.querySelector('[data-personal-trace]');
        const image = photo.querySelector('img');
        if (!trace || !image) continue;
        const timeline = gsap.timeline({
          scrollTrigger: {
            trigger: photo,
            start: 'top 91%',
            once: true,
            onEnter: () => { played.add(photo); },
          },
        });
        timeline.fromTo(trace, { scaleX: 0 }, {
          scaleX: 1, duration: 0.56, ease: 'power2.out', clearProps: 'transform',
        });
        timeline.fromTo(image, { clipPath: 'inset(0 12% 0 0)' }, {
          clipPath: 'inset(0 0% 0 0)', duration: 0.52, ease: 'power2.out',
          immediateRender: false, clearProps: 'clipPath',
        }, 0);
      }
    });
  }

  mount();
  window.addEventListener('pagehide', () => {
    media?.revert();
    media = undefined;
  });
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) mount();
  });
</script>

<style>
  .entry {
    display: grid;
    grid-template: 'copy media' / minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(18px, 4vw, 52px);
    padding-block: clamp(26px, 5vw, 54px);
    border-bottom: 1px solid var(--line);
  }

  .entry--reverse {
    grid-template: 'media copy' / minmax(0, 1.15fr) minmax(0, 1fr);
  }

  .entry-content { grid-area: copy; min-width: 0; }

  .entry-content h2 {
    margin: 7px 0 12px;
    font-size: var(--fs-h2);
    overflow-wrap: anywhere;
  }

  .entry-kicker { color: var(--accent); }

  .entry-content h2 ~ p {
    max-width: 54ch;
    color: var(--copy);
  }

  .entry-content p + p { margin-top: 12px; }

  .inline-link {
    --underline-height: 2px;
    color: var(--accent);
  }

  .entry-content .entry-note {
    padding-inline-start: 14px;
    border-inline-start: 2px solid var(--accent);
  }

  .entry-content :global(.entry-link) { margin-top: 16px; }

  .entry-media {
    grid-area: media;
    margin: 0;
    min-width: 0;
  }

  .photo-frame {
    position: relative;
    height: clamp(176px, 27vw, 330px);
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--field);
  }

  .photo-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .photo-trace {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--accent);
    transform-origin: left;
    pointer-events: none;
  }

  .entry-caption {
    margin-top: 8px;
    color: var(--muted);
    letter-spacing: 0.055em;
  }

  @media (max-width: 620px) {
    .entry, .entry--reverse { grid-template: 'copy' 'media' / minmax(0, 1fr); }
    .photo-frame { height: clamp(152px, 55vw, 284px); }
  }
</style>
