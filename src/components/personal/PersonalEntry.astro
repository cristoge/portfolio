---
import ArrowLink from '../ui/ArrowLink.astro';
import type { PersonalSection } from '../../i18n/types';
import { externalLink } from '../../lib/links';
import { linkify } from '../../lib/linkify';

interface Props {
  entry: PersonalSection;
}

const { entry } = Astro.props;
---

<article class="entry reveal">
  <h2 class="entry-title">{entry.title}</h2>
  <div class="entry-content">
    {entry.body.map((paragraph) => (
      <p>
        {linkify(paragraph, entry.inlineLinks).map((part) =>
          typeof part === 'string' ? part : (
            <a class="inline-link" href={part.href} {...externalLink}>{part.text}</a>
          ),
        )}
      </p>
    ))}
    {entry.note && <p class="entry-note">{entry.note}</p>}
    {entry.link && <ArrowLink href={entry.link.href} class="entry-link" external>{entry.link.label}</ArrowLink>}
  </div>
  <figure class="entry-media">
    <div class="photo-frame">
      <img src={entry.image} alt={entry.title} loading="lazy" />
    </div>
    {entry.caption && <figcaption class="mono entry-caption">{entry.caption}</figcaption>}
  </figure>
</article>

<style>
  /* Fila: texto alineado con la introducción y foto pequeña a la derecha,
     alineada con el primer párrafo y no con el título. */
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    grid-template-areas:
      'title .'
      'content photo';
    align-items: start;
    gap: 20px 32px;
    padding: 40px 0;
    border-top: 1px solid var(--line-strong);
  }

  .entry-content {
    grid-area: content;
    max-width: 680px;
  }

  .entry-title {
    grid-area: title;
    margin: 0;
    font-size: var(--fs-h2);
  }

  .entry-content p {
    color: var(--copy);
    font-size: var(--fs-base);
    line-height: 1.65;
  }

  .entry-content p + p {
    margin-top: 14px;
  }

  .inline-link {
    color: var(--accent);
    text-decoration: underline 1px;
    text-underline-offset: 4px;
  }

  .inline-link:hover {
    text-decoration-thickness: 2px;
  }

  .entry-content .entry-note {
    margin-top: 24px;
    padding: 14px 18px;
    border-left: 2px solid var(--accent);
    color: var(--ink);
    font-size: var(--fs-base);
  }

  .entry-content :global(.entry-link) {
    margin-top: 20px;
  }

  .entry-media {
    grid-area: photo;
    margin: 0;
  }

  .photo-frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--ink);
    background: var(--surface);
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .entry:hover .photo-frame img {
    transform: scale(1.03);
  }

  /* Pie de foto en mono, como la documentación de un caso. */
  .entry-caption {
    margin-top: 10px;
    color: var(--muted);
  }

  /* Misma columna derecha que la ficha de PersonalIntro. */
  @media (max-width: 1000px) {
    .entry {
      grid-template-columns: minmax(0, 1fr) minmax(0, 280px);
    }
  }

  @media (max-width: 760px) {
    .entry {
      grid-template-columns: 1fr;
      grid-template-areas: 'title' 'content' 'photo';
      gap: 20px;
      padding: 32px 0;
    }
  }
</style>
