---
import { getDictionary, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<header class="personal-intro">
  <p class="eyebrow">{t.personal.kicker}</p>
  <h1>{t.personal.heading}</h1>
  <div class="personal-body">
    {t.personal.intro.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <dl class="facts">
    {t.personal.facts.map((fact) => (
      <div class="fact">
        <dt class="mono">{fact.label}</dt>
        <dd>{fact.value}</dd>
      </div>
    ))}
  </dl>
</header>

<style>
  /* Introducción a la izquierda y ficha a la derecha, en la misma columna que las fotos. */
  .personal-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    grid-template-areas:
      'kicker .'
      'title .'
      'body facts';
    align-items: start;
    column-gap: 32px;
    padding-bottom: var(--intro-gap);
  }

  .eyebrow {
    grid-area: kicker;
    justify-self: start;
  }

  h1 {
    grid-area: title;
    margin-top: 24px;
  }

  .personal-body {
    grid-area: body;
    margin-top: 24px;
    max-width: 680px;
    color: var(--copy);
    font-size: var(--fs-base);
    line-height: 1.65;
  }

  .personal-body p + p {
    margin-top: 14px;
  }

  /* Ficha: etiqueta en mono a la izquierda y valor a la derecha, filas separadas por líneas. */
  .facts {
    grid-area: facts;
    margin: 24px 0 0;
    border: 1px solid var(--line-strong);
  }

  .fact {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 18px;
  }

  .fact + .fact {
    border-top: 1px solid var(--line);
  }

  .fact dt {
    padding-top: 3px;
    color: var(--muted);
  }

  .fact dd {
    margin: 0;
    color: var(--ink);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .personal-intro > * {
      animation: fade-up 0.9s var(--ease-out) both;
    }
    h1 {
      animation-delay: 0.15s;
    }
    .personal-body {
      animation-delay: 0.3s;
    }
    .facts {
      animation-delay: 0.45s;
    }
  }

  /* Misma columna derecha que las fotos de PersonalEntry. */
  @media (max-width: 1000px) {
    .personal-intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 280px);
    }
  }

  @media (max-width: 760px) {
    .personal-intro {
      grid-template-columns: 1fr;
      grid-template-areas: 'kicker' 'title' 'body' 'facts';
    }
    .facts {
      margin-top: 32px;
    }
  }
</style>
