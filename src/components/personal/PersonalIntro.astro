---
import DrawRule from '../ui/DrawRule.astro';
import EmbeddingText from '../ui/EmbeddingText.astro';
import { site } from '../../data/site';
import { getDictionary, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { kicker, heading, intro, facts } = getDictionary(lang).personal;
---

<header class="personal-intro">
  <p class="eyebrow">{kicker} <span aria-hidden="true">/</span> {site.owner}</p>
  <h1 id="personal-heading"><EmbeddingText text={heading} /><DrawRule /></h1>
  <div class="personal-body">
    {intro.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <dl class="facts">
    {facts.map((fact) => (
      <div class="fact">
        <dt class="mono">{fact.label}</dt>
        <dd>{fact.value}</dd>
      </div>
    ))}
  </dl>
</header>

<style>
  .personal-intro {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 12px var(--gutter);
  }

  .eyebrow,
  .facts {
    grid-column: 1 / -1;
  }

  .eyebrow { color: var(--accent); }

  .eyebrow::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-inline-end: 10px;
    background: var(--accent);
  }

  h1 {
    font-size: var(--fs-display);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .personal-body {
    justify-self: end;
    max-width: 48ch;
    color: var(--copy);
    font-size: var(--fs-md);
  }

  .personal-body p + p { margin-top: 12px; }

  .facts {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px var(--gutter);
    margin: clamp(14px, 3vw, 36px) 0 0;
    padding-block: 14px;
    border-block: 1px solid var(--line-strong);
  }

  .fact dt { color: var(--muted); }

  .fact dd {
    margin: 4px 0 0;
    font-size: var(--fs-sm);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  @media (max-width: 850px) {
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .personal-intro { grid-template-columns: 1fr; }
    .personal-body { justify-self: start; }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
