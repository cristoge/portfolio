---
import { externalLink } from '../../lib/links';

const papers = [
  { id: 'word2vec', title: 'word2vec', year: '2013', caption: 'Words → vectors.', href: 'https://arxiv.org/abs/1301.3781' },
  { id: 'attention', title: 'Attention Is All You Need', year: '2017', caption: 'Attention, not recurrence.', href: 'https://arxiv.org/abs/1706.03762' },
  { id: 'gpt2', title: 'GPT-2', year: '2019', caption: 'Predict the next token.', href: 'https://openai.com/index/better-language-models/' },
  { id: 'rag', title: 'RAG', year: '2020', caption: 'Retrieve, then generate.', href: 'https://arxiv.org/abs/2005.11401' },
  { id: 'instructgpt', title: 'InstructGPT', year: '2022', caption: 'Learn from human feedback.', href: 'https://arxiv.org/abs/2203.02155' },
  { id: 'react', title: 'ReAct', year: '2022', caption: 'Reason. Act. Observe.', href: 'https://arxiv.org/abs/2210.03629' },
];
---

<aside class="research-notes" aria-labelledby="research-notes-heading" lang="en">
  <h2 id="research-notes-heading">Research notes <span>{papers.length.toString().padStart(2, '0')} papers</span></h2>
  <ul class="note-wall">
    {papers.map((paper, index) => (
      <li style={`--delay:${index * 50}ms`}>
        <a class="paper-note" data-paper={paper.id} href={paper.href} {...externalLink}>
          <div class="note-meta"><span>{String(index + 1).padStart(2, '0')} / PAPER</span><span>{paper.year}</span></div>
          <h3>{paper.title}</h3>
          <svg data-draw-svg class="note-sketch" viewBox="0 0 180 72" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {paper.id === 'word2vec' && <>
              <path class="sketch-faint" d="M17 60V7M17 60H170M17 60L65 19" />
              <path d="M46 48L82 33M104 43L142 27" stroke-dasharray="3 4" />
              <g fill="currentColor" stroke="none"><circle cx="46" cy="48" r="3" /><circle cx="82" cy="33" r="3" /><circle cx="104" cy="43" r="3" /><circle cx="142" cy="27" r="3" /></g>
              <g class="sketch-label"><text x="30" y="40">king</text><text x="68" y="23">queen</text><text x="94" y="59">man</text><text x="130" y="16">woman</text></g>
            </>}
            {paper.id === 'attention' && <>
              <g class="sketch-label"><text x="23" y="13">Q</text><text x="80" y="13">K</text><text x="140" y="13">V</text></g>
              <path d="M28 19V27H88M85 19V27M145 19V57H137M88 27V35M84 31L88 35L92 31M134 53L138 57L134 61" />
              <rect x="30" y="36" width="105" height="32" rx="3" />
              <text class="sketch-label" x="40" y="56">softmax(QKᵀ/√d)</text>
            </>}
            {paper.id === 'gpt2' && <>
              <rect x="5" y="11" width="32" height="23" rx="2" /><rect x="46" y="11" width="32" height="23" rx="2" /><rect x="87" y="11" width="32" height="23" rx="2" />
              <g class="sketch-label"><text x="11" y="26">The</text><text x="50" y="26">next</text><text x="91" y="26">word</text></g>
              <path d="M21 40V51H144V23H168M163 19L168 23L163 27" />
              <rect x="139" y="8" width="37" height="29" rx="2" stroke-dasharray="3 4" />
              <text class="sketch-label" x="150" y="27">?</text><text class="sketch-label" x="29" y="68">p(next | context)</text>
            </>}
            {paper.id === 'rag' && <>
              <path d="M10 17V7H35V40H26M5 13H30V46H5Z" />
              <path class="sketch-faint" d="M10 22H23M10 28H23M10 34H20" />
              <path d="M40 27H66M61 23L66 27L61 31M111 27H137M132 23L137 27L132 31" />
              <circle cx="88" cy="25" r="13" /><path d="M97 35L105 43" />
              <path d="M142 12H176V40H155L146 48V40H142Z" />
              <g class="sketch-label"><text x="3" y="65">docs</text><text x="68" y="65">search</text><text x="136" y="65">answer</text></g>
            </>}
            {paper.id === 'instructgpt' && <>
              <rect x="9" y="9" width="104" height="15" rx="2" /><rect x="9" y="30" width="104" height="15" rx="2" /><rect x="9" y="51" width="104" height="15" rx="2" />
              <path class="sketch-faint" d="M18 16H76M18 37H61M18 58H85" />
              <path d="M124 16L129 21L141 9M124 37H139M125 54L137 66M137 54L125 66" />
              <path d="M157 59V14M152 20L157 14L162 20" /><text class="sketch-label" x="164" y="39">↑</text>
            </>}
            {paper.id === 'react' && <>
              <g class="sketch-label"><text x="62" y="13">reason</text><text x="132" y="56">act</text><text x="5" y="56">observe</text></g>
              <path d="M111 11Q152 14 151 39M147 34L151 40L155 34M137 63Q91 78 49 62M54 60L48 62L51 67M27 40Q30 12 57 11M51 7L57 11L51 15" />
            </>}
          </svg>
          <p class="note-caption">{paper.caption}</p>
          <span class="note-link" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>
</aside>

<style>
  .research-notes { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  h2 { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .note-wall { position: relative; width: 100%; height: 100%; list-style: none; margin: 0; padding: 0; }
  li { position: absolute; width: clamp(138px, 15vw, 176px); display: flex; }
  li:nth-child(1) { left: 2%; top: 6%; }
  li:nth-child(2) { right: 2%; top: 4%; }
  li:nth-child(3) { left: 0; top: 43%; }
  li:nth-child(4) { right: 0; top: 40%; }
  li:nth-child(5) { left: 14%; bottom: 4%; }
  li:nth-child(6) { right: 12%; bottom: 3%; }
  .paper-note {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 178px;
    aspect-ratio: 1;
    padding: 12px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    opacity: 0.2;
    pointer-events: auto;
  }
  .note-meta { display: flex; justify-content: space-between; gap: 8px; font: 9px/1.5 var(--font-mono); letter-spacing: 0.03em; color: var(--muted); }
  h3 { min-height: 2.4em; margin-top: 10px; font-size: 16px; font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; }
  .note-sketch { display: block; width: 100%; max-width: 180px; height: 48px; margin: 10px auto 12px; color: var(--copy); overflow: visible; }
  .sketch-faint { opacity: 0.4; }
  .sketch-label { fill: currentColor; stroke: none; font: 10px var(--font-mono); }
  .note-caption { margin-top: auto; padding-right: 22px; color: var(--muted); font: 10px/1.45 var(--font-mono); }
  .note-link { position: absolute; right: 9px; bottom: 10px; color: var(--muted); font-size: 14px; line-height: 1; }
  .paper-note:hover, .paper-note:focus-visible { border-color: var(--accent); }
  .paper-note:hover { opacity: 0.65; }
  /* Keyboard users can inspect every linked note at full contrast. */
  .research-notes:focus-within { z-index: 2; }
  .paper-note:focus-visible { opacity: 1; outline-offset: 3px; }
  @media (prefers-reduced-motion: no-preference) {
    li { animation: note-enter 500ms var(--ease-out) calc(650ms + var(--delay)) backwards; }
    .paper-note { transition: border-color 180ms var(--ease-out), opacity 180ms var(--ease-out); }
    @keyframes note-enter { from { opacity: 0; transform: translateY(8px); } }
  }
  @media (max-width: 820px) {
    li { width: 140px; }
    .paper-note { opacity: 0.14; }
    li:nth-child(1), li:nth-child(2) { top: 3%; }
    li:nth-child(3), li:nth-child(4) { top: 40%; }
    li:nth-child(5) { left: 7%; bottom: 3%; }
    li:nth-child(6) { right: 7%; bottom: 2%; }
  }
  @media (max-width: 350px) { .paper-note { padding: 10px; } h3 { font-size: 15px; } .note-meta { font-size: 8px; } }
</style>
