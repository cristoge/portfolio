---
import EmbeddingText from '../ui/EmbeddingText.astro';
import type { StackEntry } from '../../i18n/types';
import { getDictionary, type Lang } from '../../i18n/utils';
import { externalLink } from '../../lib/links';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { heading, kicker, lead, groups } = getDictionary(lang).stack;
---

<section class="section" id="stack" aria-labelledby="stack-heading" data-stack>
  <header class="stack-header">
    <p class="eyebrow stack-kicker" data-text-reveal>{kicker}</p>
    <h2 id="stack-heading" data-text-reveal><EmbeddingText text={heading} /></h2>
    <p class="lead" data-text-reveal>{lead}</p>
  </header>
  <div class="stack-mosaic">
    {groups.map(({ label, lead: entry, highlight, items }) => {
      const primary: StackEntry = typeof entry === 'string' ? { label: entry } : entry;
      return (
        <article class:list={['stack-tile', highlight && `stack-tile--${highlight}`]} data-stack-tile>
          <span class="stack-rule" aria-hidden="true" data-stack-rule></span>
          {highlight && <span class="stack-texture" aria-hidden="true" data-stack-texture></span>}
          <h3 class="mono stack-label" data-text-reveal>{label}</h3>
          <p class="stack-primary" data-text-reveal>
            {primary.href ? <a class="stack-link animated-underline underline-marked" href={primary.href} {...externalLink}>{primary.label}</a> : primary.label}
          </p>
          {primary.description && <p class="stack-description" data-text-reveal>{primary.description}</p>}
          <ul class="stack-names" role="list">
            {items.map((item) => (
              <li>
                {typeof item === 'string' ? item : (
                  <>
                    {item.href ? <a class="stack-link animated-underline underline-marked" href={item.href} {...externalLink}>{item.label}</a> : item.label}
                    {item.description && <span class="stack-description" data-text-reveal>{item.description}</span>}
                  </>
                )}
              </li>
            ))}
          </ul>
        </article>
      );
    })}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { INTRO_ACTIVE_CLASS } from '../../lib/storage';

  gsap.registerPlugin(ScrollTrigger);
  const stack = document.querySelector('[data-stack]');
  const played = new WeakSet<Element>();
  let motion: ReturnType<typeof gsap.matchMedia> | undefined;

  function mount() {
    if (!stack || motion) return;
    const section = stack;
    motion = gsap.matchMedia(section);
    motion.add('(prefers-reduced-motion: no-preference)', (context) => {
      let intro: MutationObserver | undefined;
      function start() {
        if (document.documentElement.classList.contains(INTRO_ACTIVE_CLASS)) return;
        intro?.disconnect();
        context.add(() => {
          for (const tile of section.querySelectorAll('[data-stack-tile]')) {
            const rule = tile.querySelector('[data-stack-rule]');
            if (!rule || played.has(tile)) continue;
            const texture = tile.querySelector('[data-stack-texture]');
            const timeline = gsap.timeline({ scrollTrigger: {
              trigger: tile,
              start: 'top 88%',
              once: true,
              onEnter: () => { played.add(tile); },
            } });
            timeline.fromTo(rule, { scaleX: 0 }, { scaleX: 1, duration: 0.7, ease: 'power2.out', clearProps: 'transform' });
            if (texture) timeline.from(texture, {
              x: 16, opacity: 0.08, duration: 0.6, ease: 'power2.out', clearProps: 'opacity,transform',
            }, 0.08);
          }
        });
      }
      if (document.documentElement.classList.contains(INTRO_ACTIVE_CLASS)) {
        intro = new MutationObserver(start);
        intro.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      } else start();
      return () => intro?.disconnect();
    });
  }

  mount();
  window.addEventListener('pagehide', () => {
    motion?.revert();
    motion = undefined;
  });
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) mount();
  });
</script>

<style>
  .stack-header {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: end;
    gap: 12px var(--gutter);
    margin-bottom: clamp(var(--gutter), 4vw, 48px);
  }

  .stack-kicker {
    grid-column: 1 / -1;
    color: var(--accent);
  }

  .stack-kicker::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-inline-end: 10px;
    background: var(--accent);
  }

  .stack-header h2 { font-size: var(--fs-display); line-height: 1; }
  .stack-header .lead { max-width: 34ch; }

  .stack-mosaic {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: calc(var(--gutter) / 2);
  }

  .stack-tile {
    --tile-mark: var(--accent);
    --tile-copy: var(--copy);
    --tile-muted: var(--muted);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-width: 0;
    min-height: 148px;
    padding: var(--gutter);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--field);
  }

  .stack-tile--focus,
  .stack-tile--accent {
    grid-column: span 2;
    min-height: 218px;
    background: var(--surface);
  }

  .stack-tile--accent {
    --tile-mark: var(--on-accent);
    --tile-copy: var(--on-accent);
    --tile-muted: var(--on-accent);
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .stack-rule {
    position: absolute;
    inset: 0 auto auto 0;
    width: 44px;
    height: 2px;
    background: var(--tile-mark);
    transform-origin: left;
    pointer-events: none;
  }

  .stack-tile--focus .stack-rule,
  .stack-tile--accent .stack-rule { width: 100%; height: 3px; }

  .stack-texture {
    position: absolute;
    z-index: -1;
    inset: var(--gutter) 0 0 64%;
    background-image: radial-gradient(var(--tile-mark) 1px, transparent 1px);
    background-size: 13px 13px;
    mask-image: linear-gradient(to right, transparent, var(--ink));
    opacity: 0.28;
    pointer-events: none;
  }

  .stack-label { color: var(--tile-mark); }

  .stack-primary {
    margin-top: 12px;
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.04;
    overflow-wrap: anywhere;
  }

  .stack-tile--focus .stack-primary,
  .stack-tile--accent .stack-primary { margin-top: 16px; font-size: var(--fs-h1); }

  .stack-names {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    color: var(--tile-copy);
    font-size: var(--fs-sm);
    overflow-wrap: anywhere;
  }

  .stack-tile--focus .stack-names,
  .stack-tile--accent .stack-names { max-width: 40ch; }

  .stack-link { color: var(--tile-mark); }
  .stack-link:focus-visible { outline-color: var(--tile-mark); }
  .stack-primary .stack-link { color: inherit; }

  .stack-description {
    margin-inline-start: 5px;
    color: var(--tile-muted);
    font-size: var(--fs-2xs);
  }

  @media (max-width: 840px) {
    .stack-mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stack-tile { padding: 16px; }
    .stack-tile--focus, .stack-tile--accent { grid-column: auto; }
  }

  @media (max-width: 600px) {
    .stack-header { grid-template-columns: 1fr; }
    .stack-tile { min-height: 0; }
    .stack-tile--focus, .stack-tile--accent { grid-column: span 2; }
    .stack-tile:not(.stack-tile--focus, .stack-tile--accent) .stack-primary { font-size: var(--fs-md); }
  }

  @media (max-width: 330px) {
    .stack-mosaic { grid-template-columns: minmax(0, 1fr); }
    .stack-tile--focus, .stack-tile--accent { grid-column: auto; }
  }
</style>
