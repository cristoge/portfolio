---
import SectionHeading from '../ui/SectionHeading.astro';
import { getDictionary, type Lang } from '../../i18n/utils';
import { formatIndex } from '../../lib/format';
import { externalLink } from '../../lib/links';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section class="section" id="stack">
  <SectionHeading heading={t.stack.heading} />
  <div class="stack-list">
    {t.stack.groups.map((group, i) => (
      <div class="stack-cell reveal">
        <span class="mono stack-num">{formatIndex(i)}</span>
        <h3>{group.label}</h3>
        <ul class="stack-items">
          {group.items.map((item) => (
            <li>
              {typeof item === 'string' ? item : (
                <>
                  {item.href ? <a class="stack-link" href={item.href} {...externalLink}>{item.label}</a> : item.label}
                  {item.description && <span class="stack-description">{item.description}</span>}
                </>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  /* Rejilla de 3 columnas con bordes compartidos. */
  .stack-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }

  .stack-cell {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 24px;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .stack-num {
    color: var(--accent);
  }

  .stack-items {
    margin: 4px 0 0;
    padding: 12px 0 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--line);
    color: var(--copy);
    font-size: var(--fs-sm);
  }

  .stack-items li {
    position: relative;
    padding-left: 18px;
  }

  /* Rombo pequeño como viñeta. */
  .stack-items li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border: 1px solid var(--muted);
    transform: rotate(45deg);
  }

  .stack-link {
    color: var(--accent);
    text-decoration: underline 1px;
    text-underline-offset: 4px;
  }

  .stack-link:hover {
    text-decoration-thickness: 2px;
  }

  /* Qué es una herramienta poco conocida, en gris a la derecha de su nombre. */
  .stack-description {
    margin-left: 8px;
    color: var(--muted);
    font-size: var(--fs-2xs);
  }

  @media (max-width: 900px) {
    .stack-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .stack-list {
      grid-template-columns: 1fr;
    }
  }
</style>
