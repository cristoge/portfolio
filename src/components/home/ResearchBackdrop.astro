    paths: ['M180 200H300V445H380', 'M540 445H690V200H790', 'M870 245V430H790'],
    signals: ['M180 200H300V445H540V445H690V200H790', 'M870 245V430H790'],
    nodes: [{ x: 460, y: 445, label: 'retrieve', r: 63 }],
