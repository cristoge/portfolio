  {
    id: 'gpt2',
    title: 'GPT-2',
    paths: ['M210 145H275M405 145H470M600 145H665', 'M145 185V450H405', 'M600 450H850V190', 'M850 100V65H145V100'],
    signals: ['M145 185V450H600V450H850V190', 'M850 100V65H145V100'],
    nodes: [],
