---

<div class="paper-backdrop" data-paper-backdrop aria-hidden="true">
  {scenes.map((scene) => (
    <svg class="paper-scene" data-paper-scene={scene.id} viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <text class="scene-title" x="500" y="35" text-anchor="middle">{scene.title}</text>
      {scene.paths.map((d) => <path data-scene-stroke d={d} />)}
      {scene.boxes.map((box) => (
        <g data-scene-node>
          <rect x={box.x} y={box.y} width={box.w} height={box.h} rx="3" />
          {box.label && <text x={box.x + box.w / 2} y={box.y + box.h / 2 + 5} text-anchor="middle">{box.label}</text>}
        </g>
      ))}
      {scene.nodes.map((node) => (
        <g data-scene-node>
          <circle cx={node.x} cy={node.y} r={node.r ?? 5} />
          {node.label && <text x={node.x} y={node.y + (node.r ? 5 : -16)} text-anchor="middle">{node.label}</text>}
        </g>
      ))}
      {scene.labels.map((label) => <text class="scene-caption" x={label.x} y={label.y}>{label.text}</text>)}
      {scene.signals.map((d) => <path class="scene-signal" data-scene-signal d={d} />)}
    </svg>
  ))}
</div>
<button class="paper-motion-toggle" data-paper-motion-toggle type="button" aria-pressed="false" lang="en" hidden>Pause motion</button>

<script>
  import { gsap } from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
  import { attachResearchBackdrop } from '../../lib/research-backdrop.mjs';
  import { INTRO_ACTIVE_CLASS } from '../../lib/storage';

  gsap.registerPlugin(DrawSVGPlugin);
  const root = document.querySelector('[data-paper-backdrop]');
  if (root) attachResearchBackdrop({ gsap, root, notes: [], control: document.querySelector('[data-paper-motion-toggle]'), introClass: INTRO_ACTIVE_CLASS });
</script>

<style>
  .paper-backdrop { position: absolute; inset: 0; overflow: hidden; pointer-events: none; color: var(--copy); opacity: 0.12; }
  .paper-scene { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; }
  .paper-scene:first-child { opacity: 1; }
  text { fill: currentColor; stroke: none; font: 16px var(--font-mono); }
  .scene-title { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; }
  .scene-caption { font-size: 12px; }
  .scene-signal { color: var(--accent); stroke-width: 2.5; }
  .paper-motion-toggle {
    position: absolute; right: 0; bottom: 12px; z-index: 1;
    padding: 7px 10px; border: 1px solid var(--line); background: var(--page);
    color: var(--muted); font: 10px var(--font-mono); cursor: pointer; pointer-events: auto;
  }
  .paper-motion-toggle:hover, .paper-motion-toggle:focus-visible { color: var(--ink); border-color: var(--accent); }
  @media (max-width: 820px) { .paper-backdrop { opacity: 0.075; } }
</style>
