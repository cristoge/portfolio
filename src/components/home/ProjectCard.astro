---
import ArrowLink from '../ui/ArrowLink.astro';
import type { Project } from '../../data/projects';
import { getDictionary, projectDetailPath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  project: Project;
  number: string;
}

const { lang, project, number } = Astro.props;
const { links, archive } = getDictionary(lang).projects;
const info = project.archive;
const id = `project-${project.slug}`;
---

<article class="project-case" id={id} aria-labelledby={`${id}-title`} tabindex="-1">
  <div class="case-grid" data-project-entry>
    <div>
      <p class="mono case-category"><span>{number}</span> / {info.category}</p>
      <h3 id={`${id}-title`}>
        <a class="case-title-link" href={projectDetailPath(lang, project.slug)}>{project.title}</a>
      </h3>
      <p class="case-summary">{info.summary}</p>
      <p class="case-detail">{info.detail}</p>
      <div class="case-links">
        <ArrowLink href={project.repoHref} external>{links.repo}</ArrowLink>
        {project.demoHref && <ArrowLink href={project.demoHref} external>{links.demo}</ArrowLink>}
      </div>
    </div>
    <figure class="case-shot">
      <div class="case-image"><img src={project.image} alt="" loading="lazy" /></div>
      <figcaption class="mono"><span>{archive.figure} {number}</span>{info.caption}</figcaption>
    </figure>
  </div>
  <ol class="case-flow" role="list" aria-label={archive.flow} data-draw-svg>
    {info.flow.map((step, index) => (
      <li>
        {index > 0 && (
          <svg class="case-trace" viewBox="0 0 100 14" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M0 7H94m-7-5 7 5-7 5" vector-effect="non-scaling-stroke" />
          </svg>
        )}
        {step}
      </li>
    ))}
  </ol>
</article>

<style>
  .project-case {
    padding-block: var(--gutter);
    border-bottom: 1px solid var(--line-strong);
    scroll-margin-top: calc(var(--nav-h, 60px) + 16px);
  }

  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--gutter);
    align-items: center;
  }

  .case-category {
    margin-bottom: 8px;
    color: var(--muted);
  }

  .case-category span,
  .case-shot figcaption span {
    color: var(--accent);
  }

  .case-grid h3 {
    font-size: var(--fs-h2);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .case-title-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .case-summary {
    margin-top: 12px;
    color: var(--copy);
  }

  .case-detail {
    margin-top: 10px;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    margin-top: 4px;
  }

  .case-links :global(.arrow-link) {
    min-height: 44px;
  }

  .case-shot {
    margin: 0;
    min-width: 0;
  }

  .case-image {
    height: clamp(138px, 15vw, 191px);
    border: 1px solid var(--line-strong);
    background: var(--field);
  }

  .case-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .case-shot figcaption {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 8px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .case-flow {
    --trace-width: clamp(12px, 3vw, 42px);
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr) minmax(0, 1.17fr);
    gap: var(--trace-width);
    padding: 0;
    margin: 18px 0 0;
    list-style: none;
    font: var(--fs-2xs) / 1.45 var(--font-mono);
  }

  .case-flow li {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 46px;
    padding: 7px 5px;
    border: 1px solid var(--line-strong);
    background: var(--field);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .case-trace {
    position: absolute;
    inset-inline-end: 100%;
    top: 50%;
    width: var(--trace-width);
    height: 14px;
    transform: translateY(-50%);
    overflow: visible;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
  }

  @media (max-width: 600px) {
    .case-grid { grid-template-columns: 1fr; }
    .case-image { height: clamp(160px, 56vw, 244px); }
    .case-flow { grid-template-columns: minmax(0, 0.65fr) minmax(0, 1fr) minmax(0, 1.25fr); }
  }
</style>
