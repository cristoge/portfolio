---
import ArrowLink from '../ui/ArrowLink.astro';
import type { Project } from '../../data/projects';
import { getDictionary, projectDetailPath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  project: Project;
  number: string;
}

const { lang, project, number } = Astro.props;
const { links, archive } = getDictionary(lang).projects;
const info = project.archive;
const id = `project-${project.slug}`;
---

<article class="project-case" id={id} aria-labelledby={`${id}-title`} tabindex="-1">
  <div class="case-grid">
    <div>
      <p class="mono case-category" data-text-reveal><span>{number}</span> / {info.category}</p>
      <h3 id={`${id}-title`} data-text-reveal>
        <a class="case-title-link" href={projectDetailPath(lang, project.slug)}>{project.title}</a>
      </h3>
      <p class="case-summary" data-text-reveal>{info.summary}</p>
      <p class="case-detail" data-text-reveal>{info.detail}</p>
      <div class="case-links">
        <ArrowLink href={project.repoHref} external>{links.repo}</ArrowLink>
        {project.demoHref && <ArrowLink href={project.demoHref} external>{links.demo}</ArrowLink>}
      </div>
    </div>
    <figure class="case-shot">
      <div class="case-image">
        <img src={project.image} alt="" loading="lazy" />
      </div>
      <figcaption class="mono"><span>{archive.figure} {number}</span>{info.caption}</figcaption>
    </figure>
  </div>
  <ol class="case-flow" role="list" aria-label={archive.flow} data-project-flow>
    {info.flow.map((step, index) => (
      <li>
        {index > 0 && (
          <svg class="case-trace" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path class="case-trace-base" d="M0 12H100" />
            <path class="case-dash case-dash-base" d="M0 12H100" data-project-connector />
            <path class="case-dash case-dash-middle" d="M0 12H100" data-project-connector />
            <path class="case-dash case-dash-upper" d="M0 12H100" data-project-connector />
          </svg>
        )}
        {step}
      </li>
    ))}
  </ol>
</article>

<style>
  .project-case {
    padding-block: var(--gutter);
    border-bottom: 1px solid var(--line-strong);
    scroll-margin-top: calc(var(--nav-h, 60px) + 16px);
  }

  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--gutter);
    align-items: center;
  }

  .case-category {
    margin-bottom: 8px;
    color: var(--muted);
  }

  .case-category span,
  .case-shot figcaption span {
    color: var(--accent);
  }

  .case-grid h3 {
    font-size: var(--fs-h2);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .case-title-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .case-summary {
    margin-top: 12px;
    color: var(--copy);
  }

  .case-detail {
    margin-top: 10px;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    margin-top: 4px;
  }

  .case-links :global(.arrow-link) {
    min-height: 44px;
  }

  .case-shot {
    margin: 0;
    min-width: 0;
  }

  .case-image {
    position: relative;
    overflow: hidden;
    height: clamp(138px, 15vw, 191px);
    border: 1px solid var(--line-strong);
    background: var(--field);
  }

  .case-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .case-shot figcaption {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 8px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .case-flow {
    --trace-width: clamp(12px, 3vw, 42px);
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr) minmax(0, 1.17fr);
    gap: var(--trace-width);
    padding: 0;
    margin: 18px 0 0;
    list-style: none;
    font: var(--fs-2xs) / 1.45 var(--font-mono);
  }

  .case-flow li {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 46px;
    padding: 7px 5px;
    border: 1px solid var(--line-strong);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line-strong));
    background: var(--field);
    box-shadow:
      0 0 16px color-mix(in srgb, var(--accent) 16%, transparent),
      inset 0 0 12px color-mix(in srgb, var(--accent) 6%, transparent);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .case-trace {
    position: absolute;
    inset-inline-end: 100%;
    top: 50%;
    width: var(--trace-width);
    height: 24px;
    transform: translateY(-50%);
    overflow: hidden;
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    pointer-events: none;
  }

  .case-trace-base {
    stroke-width: 1;
    opacity: 0.2;
  }

  .case-dash {
    stroke-dasharray: 30 100;
  }

  .case-dash-base { stroke-width: 8; opacity: 0.15; }
  .case-dash-middle { stroke-width: 4; opacity: 0.5; }
  .case-dash-upper { stroke-width: 1.4; }

  @media (prefers-reduced-motion: reduce) {
    .case-dash { display: none; }
    .case-trace-base { opacity: 0.6; }
  }

  @media (max-width: 600px) {
    .case-grid { grid-template-columns: 1fr; }
    .case-image { height: clamp(160px, 56vw, 244px); }
    .case-flow { grid-template-columns: minmax(0, 0.65fr) minmax(0, 1fr) minmax(0, 1.25fr); }
  }
</style>
