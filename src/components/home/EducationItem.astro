---
import ArrowLink from '../ui/ArrowLink.astro';
import type { EducationEntry } from '../../i18n/types';
import { externalLink } from '../../lib/links';

interface Props {
  entry: EducationEntry;
  courseworkLabel: string;
}

const { entry, courseworkLabel } = Astro.props;
const { institution, institutionHref, degree, dates, note, coursework, link } = entry;
---

<div class="education-item reveal">
  <span class="mono education-dates">{dates}</span>
  <div class="education-main">
    <h3>{degree}</h3>
    {institutionHref ? (
      <a class="mono education-institution" href={institutionHref} {...externalLink}>
        {institution} <span class="arrow" aria-hidden="true">→</span>
      </a>
    ) : (
      <span class="mono education-institution">{institution}</span>
    )}
    {note && <p class="education-note">{note}</p>}
    {coursework && coursework.length > 0 && (
      <p class="education-coursework">
        <span class="mono education-label">{courseworkLabel}</span>
        {coursework.join(', ')}
      </p>
    )}
    {link && <ArrowLink href={link.href} class="education-link" external>{link.label}</ArrowLink>}
  </div>
</div>

<style>
  /* Fila de currículum: fecha en monoespaciada a la izquierda, contenido a la derecha. */
  .education-item {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    align-items: start;
    gap: 32px;
    padding: 28px 0;
    border-top: 1px solid var(--line-strong);
  }

  .education-item:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .education-dates {
    padding-top: 4px;
    color: var(--accent);
  }

  /* El bloque conserva su ancho de lectura pero se pega al borde derecho. */
  .education-main {
    justify-self: end;
    width: 100%;
    max-width: 68ch;
  }

  .education-institution {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    color: var(--muted);
  }

  a.education-institution {
    min-height: 32px;
    color: var(--accent);
  }

  a.education-institution:hover {
    text-decoration: underline 1px;
    text-underline-offset: 4px;
  }

  .education-note,
  .education-coursework {
    margin-top: 10px;
    color: var(--copy);
  }

  .education-coursework {
    margin-top: 16px;
    font-size: var(--fs-sm);
  }

  .education-label {
    display: block;
    margin-bottom: 4px;
    color: var(--muted);
  }

  .education-main :global(.education-link) {
    margin-top: 8px;
  }

  @media (max-width: 760px) {
    .education-item {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 24px 0;
    }
    .education-dates {
      padding-top: 0;
    }
  }
</style>
