---
import ArrowLink from '../ui/ArrowLink.astro';
import type { EducationEntry } from '../../i18n/types';
import { externalLink } from '../../lib/links';

interface Props {
  entry: EducationEntry;
  courseworkLabel: string;
  connect: boolean;
}

const { entry, courseworkLabel, connect } = Astro.props;
const { institution, institutionHref, degree, dates, subject, status, note, coursework, link } = entry;
---

<li class="education-item" data-education-stage>
  <div class="education-stamp">
    <span class="mono education-dates">{dates}</span>
    {status && <span class="mono education-status">{status}</span>}
  </div>
  <div class="education-track" aria-hidden="true">
    <span class="education-node" data-education-node></span>
    {connect && <span class="education-rail"><span class="education-trace" data-education-trace></span></span>}
  </div>
  <div class="education-main">
    <p class="mono education-meta" data-text-reveal>
      {subject} <span class="education-separator" aria-hidden="true">/</span>
      {institutionHref ? (
        <a class="education-institution" href={institutionHref} {...externalLink}>
          {institution} <span aria-hidden="true">↗</span>
        </a>
      ) : institution}
    </p>
    <h3 data-text-reveal>{degree}</h3>
    {note && <p class="education-note" data-text-reveal>{note}</p>}
    {coursework && coursework.length > 0 && (
      <p class="education-coursework" data-text-reveal>
        <span class="mono education-label">{courseworkLabel}</span>
        {coursework.join(' · ')}
      </p>
    )}
    {link && <ArrowLink href={link.href} class="education-link" external>{link.label}</ArrowLink>}
  </div>
</li>

<style>
  .education-item {
    --node-size: 9px;
    --track-size: 2px;
    --track-offset: 5px;
    display: grid;
    grid-template-columns: minmax(140px, 0.27fr) var(--node-size) minmax(0, 1fr);
    gap: 0 var(--gutter);
    padding-block: var(--gutter);
    border-bottom: 1px solid var(--line);
  }

  .education-stamp {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin-top: var(--track-offset);
    color: var(--accent);
  }

  .education-status {
    padding: 2px 6px;
    border: 1px solid var(--line-strong);
    background: var(--accent-soft);
    letter-spacing: 0.05em;
  }

  .education-track {
    position: relative;
    margin-top: var(--track-offset);
    pointer-events: none;
    isolation: isolate;
  }

  .education-node {
    position: relative;
    z-index: 1;
    display: block;
    width: var(--node-size);
    height: var(--node-size);
    background: var(--accent);
  }

  .education-rail {
    position: absolute;
    inset-block: calc(var(--node-size) / 2) calc(-2 * var(--gutter) - var(--track-offset) - var(--node-size) / 2 - 1px);
    inset-inline-start: calc((var(--node-size) - var(--track-size)) / 2);
    width: var(--track-size);
    background: var(--line-strong);
  }

  .education-trace {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: top;
  }

  .education-meta {
    margin-bottom: 8px;
    color: var(--muted);
  }

  .education-separator {
    margin-inline: 3px;
    color: var(--accent);
  }

  .education-institution {
    display: inline-block;
    padding-block: 3px;
    color: var(--accent);
  }

  .education-institution:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .education-main h3 {
    font-size: var(--fs-h2);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .education-note,
  .education-coursework {
    max-width: 68ch;
    color: var(--copy);
  }

  .education-note { margin-top: 12px; }

  .education-coursework {
    margin-top: 16px;
    font-size: var(--fs-sm);
  }

  .education-label {
    display: block;
    margin-bottom: 3px;
    color: var(--muted);
  }

  .education-main :global(.education-link) { margin-top: 8px; }

  @media (max-width: 650px) {
    .education-item {
      grid-template: 'track stamp' auto 'track content' 1fr / var(--node-size) minmax(0, 1fr);
      gap: 8px 16px;
    }

    .education-stamp {
      grid-area: stamp;
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px 10px;
      margin-top: 0;
    }

    .education-track { grid-area: track; }
    .education-main { grid-area: content; }
  }
</style>
