---
import ArrowLink from '../ui/ArrowLink.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import { site } from '../../data/site';
import { getDictionary, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  // id del contenido que se despliega con "Veure-ho tot" (ver HomeReveal.astro).
  revealId: string;
}

const { lang, revealId } = Astro.props;
const t = getDictionary(lang);
const greetingWords = t.hero.greeting.split(' ');
---

<section class="hero-intro">
  <div class="hero-intro-body">
    <div class="hero-main">
      <p class="eyebrow hero-kicker">
        <span class="status-dot" aria-hidden="true"></span>
        {t.hero.kicker} <span aria-hidden="true">·</span> {t.hero.status}
      </p>
      <h1>
        {greetingWords.map((word, i) => <><span class="word"><span style={`--i:${i}`}>{word}</span></span>{' '}</>)}
        <span class="squiggle">
          <span class="word"><span style={`--i:${greetingWords.length}`}>{t.hero.name}</span></span>
          <svg class="squiggle-line" viewBox="0 0 200 10" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 6 C 30 2, 60 9, 95 5 S 160 2, 198 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" pathLength="1" />
          </svg>
        </span>
      </h1>
    </div>
    <div class="hero-side">
      <p class="lead">{t.hero.tagline}</p>
      <div class="hero-actions">
        <ButtonLink href={site.cvHref} external>{t.hero.cta}</ButtonLink>
        <ArrowLink href={site.github.href} external>{site.github.label}</ArrowLink>
      </div>
    </div>
  </div>

  <button type="button" class="scroll-cta" data-reveal-toggle aria-expanded="false" aria-controls={revealId}>
    <span>{t.hero.exploreCta}</span>
    <span class="arrow arrow-down" aria-hidden="true">↓</span>
  </button>
</section>

<script>
  import { HOME_REVEALED_CLASS, HOME_REVEALED_KEY } from '../../lib/storage';

  // Con JS, la portada muestra solo el hero; el resto aparece al pulsar el botón
  // (o al llegar con un #ancla que apunta dentro). Se recuerda durante la sesión.
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-reveal-toggle]');
  const content = document.getElementById(toggle?.getAttribute('aria-controls') ?? '');

  const markRevealed = () => {
    try {
      sessionStorage.setItem(HOME_REVEALED_KEY, 'true');
    } catch {
      // ignore (private browsing / storage disabled)
    }
    root.classList.add(HOME_REVEALED_CLASS);
    toggle?.setAttribute('aria-expanded', 'true');
  };

  if (root.classList.contains(HOME_REVEALED_CLASS)) {
    toggle?.setAttribute('aria-expanded', 'true');
  }

  const hashTarget = window.location.hash ? document.getElementById(window.location.hash.slice(1)) : null;

  if (content && hashTarget && content.contains(hashTarget)) {
    markRevealed();
    requestAnimationFrame(() => hashTarget.scrollIntoView({ block: 'start' }));
  }

  toggle?.addEventListener('click', () => {
    markRevealed();
    content?.scrollIntoView({ block: 'start' });
  });
</script>

<style>
  /* Mientras el hero está bloqueado no hay scroll y se ocultan el contenido y el footer. */
  :global(html.js[data-hero-lock]:not(.home-revealed)),
  :global(html.js[data-hero-lock]:not(.home-revealed) body) {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  :global(html.js[data-hero-lock]:not(.home-revealed) [data-home-reveal]),
  :global(html.js[data-hero-lock]:not(.home-revealed) #site-footer) {
    display: none;
  }

  .hero-intro {
    height: calc(100dvh - var(--nav-h, 60px));
    max-height: calc(100dvh - var(--nav-h, 60px));
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 24px 0 28px;
    /* Solo se recorta en vertical: en horizontal la onda del punto de estado
       sobresale del borde izquierdo. */
    overflow-x: visible;
    overflow-y: clip;
  }

  /* Portada alineada a la izquierda: etiqueta, titular grande, entradilla y botones. */
  .hero-intro-body {
    margin: auto 0;
    padding-bottom: 6vh;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Rótulo del titular con un punto de estado "en línea" en azul. */
  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .status-dot {
    position: relative;
    width: 7px;
    height: 7px;
    margin-right: 4px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  /* Onda que sale del punto, como un indicador de "en línea". */
  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
  }

  .hero-intro h1 {
    max-width: 16ch;
    margin-top: 20px;
    font-size: var(--fs-display);
    letter-spacing: -0.02em;
    line-height: 1.06;
  }

  /* Titular partido en palabras que suben desde una máscara. */
  .word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    margin: -0.2em -0.08em -0.2em 0;
    padding: 0.2em 0.08em 0.2em 0;
  }

  .word > span {
    display: inline-block;
  }

  /* Subrayado a mano en azul bajo el nombre. */
  .squiggle {
    position: relative;
    display: inline-block;
  }

  .squiggle-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.16em;
    overflow: visible;
    color: var(--accent);
  }

  .hero-side .lead {
    max-width: 56ch;
  }

  .hero-actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-main .eyebrow {
      animation: fade-up 0.7s var(--ease-out) 0.1s both;
    }
    .status-dot::after {
      animation: status-pulse 2.4s var(--ease-out) 1.2s infinite;
    }
    @keyframes status-pulse {
      from {
        opacity: 0.5;
        transform: scale(1);
      }
      70%,
      to {
        opacity: 0;
        transform: scale(3);
      }
    }
    .word > span {
      animation: word-up 0.9s var(--ease-out) both;
      animation-delay: calc(0.25s + var(--i) * 90ms);
    }
    .squiggle-line path {
      stroke-dasharray: 1;
      animation: draw 0.9s var(--ease-out) 0.9s both;
    }
    .hero-side {
      animation: fade-up 0.9s var(--ease-out) 0.65s both;
    }
    .scroll-cta {
      animation: fade-up 0.9s var(--ease-out) 0.9s both;
    }
  }

  :global(html.home-revealed) .scroll-cta {
    display: none;
  }

  .scroll-cta {
    align-self: center;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--copy);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .scroll-cta:hover {
    color: var(--accent);
  }

  .scroll-cta:hover .arrow-down {
    transform: translateY(3px);
  }

  @media (max-width: 640px) {
    .hero-intro {
      padding: 20px 0;
    }
  }
</style>
