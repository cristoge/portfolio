---
import ArrowLink from '../ui/ArrowLink.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import ResearchNotes from './ResearchNotes.astro';
import EmbeddingText from '../ui/EmbeddingText.astro';
import { site } from '../../data/site';
import { getDictionary, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const greetingWords = t.hero.greeting.split(' ');
---

<section class="hero-intro">
  <div class="hero-intro-body">
    <div class="hero-main">
      <p class="eyebrow hero-kicker">
        <span class="status-dot" aria-hidden="true"></span>
        {t.hero.kicker} <span aria-hidden="true">·</span> {t.hero.status}
      </p>
      <h1>
        {greetingWords.map((word, i) => <><span class="word"><span style={`--i:${i}`}><EmbeddingText text={word} /></span></span>{' '}</>)}
        <span class="squiggle">
          <span class="word"><span style={`--i:${greetingWords.length}`}><EmbeddingText text={t.hero.name} /></span></span>
          <svg data-draw-svg class="squiggle-line" viewBox="0 0 200 10" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 6H198" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>
      </h1>
    </div>
    <div class="hero-side">
      <p class="lead">{t.hero.tagline}</p>
      <div class="hero-actions">
        <ButtonLink href={site.cvHref} external>{t.hero.cta}</ButtonLink>
        <ArrowLink href={site.github.href} external>{site.github.label}</ArrowLink>
      </div>
    </div>
  </div>
  <ResearchNotes />
</section>

<style>
  /* The introduction stays in front; research notes frame its edges. */
  .hero-intro {
    min-height: min(780px, calc(100svh - var(--nav-h, 60px)));
    display: grid;
    place-items: center;
    position: relative;
    isolation: isolate;
    padding: 112px 0;
    /* Solo se recorta en vertical: en horizontal la onda del punto de estado
       sobresale del borde izquierdo. */
    overflow-x: visible;
    overflow-y: clip;
  }

  /* Portada alineada a la izquierda: etiqueta, titular grande, entradilla y botones. */
  .hero-intro-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    min-width: 0;
    width: 100%;
    max-width: 680px;
    text-align: center;
  }

  /* Rótulo del titular con un punto de estado "en línea" en azul. */
  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .status-dot {
    position: relative;
    width: 7px;
    height: 7px;
    margin-right: 4px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  /* Onda que sale del punto, como un indicador de "en línea". */
  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
  }

  .hero-intro h1 {
    max-width: none;
    margin-top: 24px;
    font-size: clamp(42px, 5.5vw, 76px);
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  /* Titular partido en palabras que suben desde una máscara. */
  .word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    margin: -0.2em -0.08em -0.2em 0;
    padding: 0.2em 0.08em 0.2em 0;
  }

  .word > span {
    display: inline-block;
  }

  /* A restrained blue rule echoes the research grid's straight lines. */
  .squiggle {
    position: relative;
    display: inline-block;
  }

  .squiggle-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.12em;
    overflow: visible;
    color: var(--accent);
  }

  .hero-side .lead {
    max-width: 44ch;
    margin-inline: auto;
    font-size: 18px;
  }

  .hero-actions {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 24px;
  }

  @media (max-width: 820px) {
    .hero-intro {
      min-height: 680px;
      padding-block: 140px;
    }
    .hero-intro-body { max-width: 540px; }
  }

  @media (max-width: 640px) {
    .hero-intro { min-height: 640px; padding-block: 136px; }
    .hero-intro h1 { font-size: clamp(34px, 9vw, 48px); }
    .hero-side .lead { font-size: 17px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-main .eyebrow {
      animation: fade-up 0.7s var(--ease-out) 0.1s both;
    }
    .status-dot::after {
      animation: status-pulse 2.4s var(--ease-out) 1.2s infinite;
    }
    @keyframes status-pulse {
      from {
        opacity: 0.5;
        transform: scale(1);
      }
      70%,
      to {
        opacity: 0;
        transform: scale(3);
      }
    }
    .word > span {
      animation: word-up 0.9s var(--ease-out) both;
      animation-delay: calc(0.25s + var(--i) * 90ms);
    }
    .hero-side {
      animation: fade-up 0.9s var(--ease-out) 0.65s both;
    }
  }

</style>
