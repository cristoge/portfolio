---
import { site } from '../../data/site';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="map-embed">
  <iframe src={site.mapEmbedSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={title}></iframe>
</div>

<style>
  /* Mapa en escala de grises que recupera el color al pasar el ratón. */
  .map-embed {
    min-height: 400px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .map-embed:focus-within {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.6s var(--ease-in-out);
  }

  :global(:root[data-theme='dark']) iframe {
    filter: grayscale(1) invert(0.92) contrast(0.9);
  }

  .map-embed:hover iframe,
  :global(:root[data-theme='dark']) .map-embed:hover iframe {
    filter: none;
  }

  @media (max-width: 900px) {
    .map-embed {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 640px) {
    .map-embed {
      aspect-ratio: 4 / 3;
    }
  }
</style>
