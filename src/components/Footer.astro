---
import { getDictionary, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer" id="site-footer">
  <div class="container footer-bottom">
    <span>© {year} {t.footer.owner}</span>
    <a href="https://astro.build" class="footer-link" target="_blank" rel="noopener noreferrer">
      {t.footer.builtWith} <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Área táctil de 44px sin mover nada. */
  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-block: 14px;
    margin-block: -14px;
    transition: color 0.2s;
  }

  .footer-link:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
