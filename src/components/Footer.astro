---
import { getDictionary, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer" id="site-footer">
  <div class="container footer-bottom">
    <span>© {year} {t.footer.owner}</span>
    <a href="https://astro.build" class="footer-link" target="_blank" rel="noopener noreferrer">
      <span class="prompt" aria-hidden="true">&gt;</span> {t.footer.builtWith}
    </a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--panel);
    color: var(--panel-ink);
    padding: 26px 0;
  }

  :global(:root[data-theme='dark']) .site-footer {
    border-top: 1px solid var(--panel-line);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--panel-muted);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-link {
    align-self: flex-start;
    padding-bottom: 2px;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: color 0.2s, background-size 0.35s var(--ease-out);
  }

  .footer-link:hover {
    color: var(--panel-ink);
    background-size: 100% 1px;
  }

  @media (max-width: 640px) {
    .footer-bottom {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
