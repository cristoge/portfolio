---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getDictionary, localePath, pageSlug, type Lang, type Page } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: Page;
  path?: string;
}

const { lang, page, path } = Astro.props;
const t = getDictionary(lang);
const currentPath = path ?? pageSlug(page);

const navItems: { page: Page; label: string }[] = [
  { page: 'home', label: t.nav.home },
  { page: 'personal', label: t.nav.personal },
  { page: 'contact', label: t.nav.contact },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href={localePath(lang, 'home')} class="brand">C.</a>
    <nav class="nav-links" aria-label="Main navigation">
      {navItems.map((item) => (
        <a
          href={localePath(lang, item.page)}
          class={`nav-link ${item.page === page ? 'active' : ''}`}
          aria-current={item.page === page ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="lang-slot">
      <LanguageSwitcher lang={lang} path={currentPath} />
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector('.nav');

  const setNavHeight = () => {
    if (nav instanceof HTMLElement) {
      document.documentElement.style.setProperty('--nav-h', `${nav.offsetHeight}px`);
    }
  };

  setNavHeight();
  window.addEventListener('resize', setNavHeight);
</script>

<style>
  .nav {
    background: rgba(255, 255, 255, 0.76);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: 0 1px 0 var(--line);
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 5px;
    background: var(--gradient);
    background-size: 240% 240%;
    animation: gradient-shift 5s ease infinite;
    font-family: var(--font-display);
    font-size-adjust: none;
    font-size: 20px;
    font-weight: 400;
    text-decoration: none;
    color: var(--primary);
    justify-self: start;
  }

  .nav-links {
    display: flex;
    gap: 8px;
  }

  .lang-slot {
    justify-self: end;
  }

  .nav-link {
    position: relative;
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-soft);
    text-decoration: none;
    padding: 6px 10px;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--ease);
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    color: var(--primary);
    font-weight: 400;
  }

  @media (max-width: 560px) {
    .nav-inner {
      display: flex;
      flex-wrap: wrap;
      row-gap: 10px;
    }
    .nav-links {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      gap: 12px;
    }
  }
</style>
