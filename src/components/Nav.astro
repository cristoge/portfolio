---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getDictionary, localePath, pageSlug, type Lang, type Page } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: Page;
  path?: string;
}

const { lang, page, path } = Astro.props;
const t = getDictionary(lang);
const currentPath = path ?? pageSlug(page);

const navItems: { page: Page; label: string }[] = [
  { page: 'home', label: t.nav.home },
  { page: 'personal', label: t.nav.personal },
  { page: 'contact', label: t.nav.contact },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href={localePath(lang, 'home')} class="brand">{t.hero.name}</a>
    <nav class="nav-links" aria-label="Main navigation">
      {navItems.map((item) => (
        <a
          href={localePath(lang, item.page)}
          class="nav-link"
          aria-current={item.page === page ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="nav-actions">
      <LanguageSwitcher lang={lang} path={currentPath} />
      <button
        type="button"
        class="theme-toggle"
        aria-label={t.theme.toggle}
        aria-pressed="false"
        data-label-dark={t.theme.dark}
        data-label-light={t.theme.light}
      >
        <span class="theme-toggle-icon" aria-hidden="true"></span>
        <span class="theme-toggle-label">{t.theme.dark}</span>
      </button>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector('.nav');
  const root = document.documentElement;

  const setNavHeight = () => {
    if (nav instanceof HTMLElement) {
      root.style.setProperty('--nav-h', `${nav.offsetHeight}px`);
    }
  };

  setNavHeight();
  window.addEventListener('resize', setNavHeight);

  // Botón de tema: la etiqueta muestra el modo al que se cambiará.
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const label = toggle?.querySelector('.theme-toggle-label');

  const syncToggle = () => {
    const isDark = root.dataset.theme === 'dark';
    toggle?.setAttribute('aria-pressed', String(isDark));
    if (toggle && label) {
      label.textContent = (isDark ? toggle.dataset.labelLight : toggle.dataset.labelDark) ?? '';
    }
  };

  syncToggle();

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    if (next === 'dark') root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // ignore (private browsing / storage disabled)
    }
    syncToggle();
  });

  // Oculta la barra al bajar y la recupera al subir.
  let lastY = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      nav?.classList.toggle('is-hidden', y > lastY && y > 200);
      lastY = y;
    },
    { passive: true },
  );
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--page);
    border-bottom: 1px solid var(--line);
    transition: transform 0.35s var(--ease-out);
  }

  .nav.is-hidden:not(:focus-within) {
    transform: translateY(-100%);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: 84px;
  }

  .brand {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    margin-left: auto;
  }

  .nav-link {
    padding-block: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.03em;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.35s var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current] {
    background-size: 100% 1px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-width: 76px;
    padding: 10px 0;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .theme-toggle-icon {
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    border: 1.5px solid;
    border-radius: 50%;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    transition: transform 0.6s var(--ease-in-out);
  }

  :global(:root[data-theme='dark']) .theme-toggle-icon {
    transform: rotate(180deg);
  }

  .theme-toggle:hover .theme-toggle-label {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (max-width: 640px) {
    .nav-inner {
      flex-wrap: wrap;
      gap: 0 16px;
      min-height: 0;
      padding-top: 14px;
    }
    .nav-actions {
      margin-left: auto;
      gap: 14px;
      padding-left: 0;
      border-left: 0;
    }
    .theme-toggle {
      min-width: 0;
    }
    .theme-toggle-label {
      display: none;
    }
    .nav-links {
      order: 3;
      width: 100%;
      margin: 10px 0 0;
      padding: 12px 0;
      gap: 22px;
      border-top: 1px solid var(--line);
    }
  }
</style>
