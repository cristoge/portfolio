---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getDictionary, localePath, pageSlug, type Lang, type Page } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: Page;
  path?: string;
}

const { lang, page, path } = Astro.props;
const t = getDictionary(lang);
const currentPath = path ?? pageSlug(page);

const navItems: { page: Page; label: string }[] = [
  { page: 'home', label: t.nav.home },
  { page: 'personal', label: t.nav.personal },
  { page: 'contact', label: t.nav.contact },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href={t.hero.ctaHref} class="nav-cta" target="_blank" rel="noopener noreferrer">{t.hero.cta}</a>

    <nav class="nav-links" aria-label={t.nav.ariaLabel}>
      {navItems.map((item) => (
        <a
          href={localePath(lang, item.page)}
          class="nav-link"
          aria-current={item.page === page ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <LanguageSwitcher lang={lang} path={currentPath} />
      <button
        type="button"
        class="theme-toggle"
        aria-label={t.theme.toggle}
        aria-pressed="false"
        title={t.theme.dark}
        data-label-dark={t.theme.dark}
        data-label-light={t.theme.light}
      >
        <span class="theme-toggle-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector('.nav');
  const root = document.documentElement;

  const setNavHeight = () => {
    if (nav instanceof HTMLElement) {
      root.style.setProperty('--nav-h', `${nav.offsetHeight}px`);
    }
  };

  setNavHeight();
  window.addEventListener('resize', setNavHeight);

  // Botón de tema: el título indica el modo al que se cambiará.
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

  const syncToggle = () => {
    const isDark = root.dataset.theme === 'dark';
    toggle?.setAttribute('aria-pressed', String(isDark));
    if (toggle) {
      toggle.title = (isDark ? toggle.dataset.labelLight : toggle.dataset.labelDark) ?? '';
    }
  };

  syncToggle();

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    if (next === 'dark') root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // ignore (private browsing / storage disabled)
    }
    syncToggle();
  });
</script>

<style>
  /* Barra fina semitransparente con línea inferior. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--page) 95%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 60px;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    background: var(--ink);
    color: var(--page);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 0.2s, opacity 0.4s var(--ease-out), visibility 0.4s;
  }

  .nav-cta:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  /* En la portada el CV ya está en el hero: el del header aparece al pulsar "Veure-ho tot". */
  :global(html.js[data-hero-lock]:not(.home-revealed)) .nav-cta {
    opacity: 0;
    visibility: hidden;
  }

  .nav-links {
    display: flex;
    margin-left: auto;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    color: var(--copy);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .nav-link[aria-current] {
    color: var(--ink);
    text-decoration: underline 1px;
    text-underline-offset: 6px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 14px;
    border-left: 1px solid var(--line);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .theme-toggle-icon {
    width: 14px;
    height: 14px;
    border: 1.5px solid;
    border-radius: 50%;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    transition: transform 0.6s var(--ease-in-out);
  }

  :global(:root[data-theme='dark']) .theme-toggle-icon {
    transform: rotate(180deg);
  }

  /* En pantallas pequeñas los enlaces pasan a una segunda fila. */
  @media (max-width: 900px) {
    .nav-inner {
      flex-wrap: wrap;
      gap: 0 12px;
      padding-top: 10px;
    }
    .nav-actions {
      margin-left: auto;
      padding-left: 0;
      border-left: 0;
    }
    .nav-links {
      order: 3;
      width: calc(100% + var(--gutter) * 2);
      margin: 10px calc(var(--gutter) * -1) 0;
      padding: 0 calc(var(--gutter) - 14px);
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 400px) {
    .nav-cta {
      padding: 0 12px;
    }
    .nav-actions {
      gap: 4px;
    }
    .nav-actions :global(.lang-option) {
      min-width: 28px;
      letter-spacing: 0.08em;
    }
  }
</style>
