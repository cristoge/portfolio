---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getDictionary, localePath, pageSlug, type Lang, type Page } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: Page;
  path?: string;
}

const { lang, page, path } = Astro.props;
const t = getDictionary(lang);
const currentPath = path ?? pageSlug(page);

const navItems: { page: Page; label: string }[] = [
  { page: 'home', label: t.nav.home },
  { page: 'personal', label: t.nav.personal },
  { page: 'contact', label: t.nav.contact },
];
---

<header class="nav">
  <div class="nav-inner">
    <a href={t.hero.ctaHref} class="nav-cta" target="_blank" rel="noopener noreferrer">{t.hero.cta}</a>

    <nav class="nav-links" aria-label={t.nav.ariaLabel}>
      {navItems.map((item) => (
        <a
          href={localePath(lang, item.page)}
          class="nav-link"
          aria-current={item.page === page ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <LanguageSwitcher lang={lang} path={currentPath} />
      <button
        type="button"
        class="theme-toggle"
        aria-label={t.theme.toggle}
        aria-pressed="false"
        title={t.theme.dark}
        data-label-dark={t.theme.dark}
        data-label-light={t.theme.light}
      >
        <span class="theme-toggle-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector('.nav');
  const root = document.documentElement;

  const setNavHeight = () => {
    if (nav instanceof HTMLElement) {
      root.style.setProperty('--nav-h', `${nav.offsetHeight}px`);
    }
  };

  setNavHeight();
  window.addEventListener('resize', setNavHeight);

  // Botón de tema: el título indica el modo al que se cambiará.
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

  const syncToggle = () => {
    const isDark = root.dataset.theme === 'dark';
    toggle?.setAttribute('aria-pressed', String(isDark));
    if (toggle) {
      toggle.title = (isDark ? toggle.dataset.labelLight : toggle.dataset.labelDark) ?? '';
    }
  };

  syncToggle();

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    if (next === 'dark') root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // ignore (private browsing / storage disabled)
    }
    syncToggle();
  });
</script>

<style>
  /* Barra blanca fija arriba con línea fina debajo, como la de orea.uk. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--page);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 66px;
    padding: 0 20px;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--page);
    font-size: var(--fs-sm);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .nav-cta:hover {
    opacity: 0.82;
  }

  .nav-links {
    display: flex;
    margin-left: auto;
  }

  .nav-link {
    padding: 22px 16px;
    font-size: var(--fs-sm);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .nav-link:hover,
  .nav-link[aria-current] {
    text-decoration: underline 2px;
    text-underline-offset: 4px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav-actions :global(.lang-option) {
    min-width: 36px;
    min-height: 44px;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .theme-toggle:hover {
    border-color: var(--ink);
  }

  .theme-toggle-icon {
    width: 16px;
    height: 16px;
    border: 1.5px solid;
    border-radius: 50%;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    transition: transform 0.6s var(--ease-in-out);
  }

  :global(:root[data-theme='dark']) .theme-toggle-icon {
    transform: rotate(180deg);
  }

  /* Sin menú hamburguesa: en pantallas pequeñas los enlaces pasan a una segunda fila. */
  @media (max-width: 900px) {
    .nav-inner {
      flex-wrap: wrap;
      gap: 0 12px;
      padding: 10px 16px 0;
    }
    .nav-actions {
      margin-left: auto;
    }
    .nav-links {
      order: 3;
      width: calc(100% + 32px);
      margin: 8px -16px 0;
      padding: 0 4px;
      border-top: 1px solid var(--line);
    }
    .nav-link {
      padding: 14px 12px;
    }
  }

  @media (max-width: 480px) {
    .nav-cta {
      padding: 0 14px;
    }
    .nav-actions {
      gap: 8px;
    }
    .nav-actions :global(.lang-switcher) {
      gap: 0;
    }
    .nav-actions :global(.lang-option) {
      min-width: 32px;
    }
  }
</style>
