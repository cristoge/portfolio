---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getDictionary, localePath, pageSlug, type Lang, type Page } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: Page;
  path?: string;
}

const { lang, page, path } = Astro.props;
const t = getDictionary(lang);
const currentPath = path ?? pageSlug(page);

const navItems: { page: Page; label: string }[] = [
  { page: 'home', label: t.nav.home },
  { page: 'personal', label: t.nav.personal },
  { page: 'contact', label: t.nav.contact },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href={localePath(lang, 'home')} class="brand">C.</a>
    <nav class="nav-links" aria-label="Main navigation">
      {navItems.map((item) => (
        <a
          href={localePath(lang, item.page)}
          class={`nav-link ${item.page === page ? 'active' : ''}`}
          aria-current={item.page === page ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="lang-slot">
      <LanguageSwitcher lang={lang} path={currentPath} />
    </div>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .brand {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 600;
    text-decoration: none;
    color: var(--forest);
    justify-self: start;
  }

  .nav-links {
    display: flex;
    gap: 4px;
  }

  .lang-slot {
    justify-self: end;
  }

  .nav-link {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.active {
    color: var(--forest);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .nav-inner {
      display: flex;
      flex-wrap: wrap;
      row-gap: 10px;
    }
    .nav-links {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      gap: 12px;
    }
  }
</style>
