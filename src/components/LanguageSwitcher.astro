---
import { getDictionary, languages, languageLabels, localizedPath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = getDictionary(lang);
---

<div class="lang-switcher" role="group" aria-label={t.nav.languageLabel}>
  {languages.map((l) => (
    <a
      href={localizedPath(l, path)}
      class="lang-option"
      lang={l}
      hreflang={l}
      aria-current={l === lang ? 'page' : undefined}
    >
      {languageLabels[l]}
    </a>
  ))}
</div>

<style>
  .lang-switcher {
    display: flex;
    gap: 4px;
  }

  .lang-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    min-height: 44px;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .lang-option:hover {
    color: var(--ink);
    text-decoration: underline 2px;
    text-underline-offset: 4px;
  }

  .lang-option[aria-current] {
    color: var(--ink);
  }
</style>
