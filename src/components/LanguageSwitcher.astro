---
import { languages, languageLabels, localizedPath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
---

<div class="lang-switcher">
  {languages.map((l) => (
    <a
      href={localizedPath(l, path)}
      class={`lang-option ${l === lang ? 'active' : ''}`}
      aria-current={l === lang ? 'page' : undefined}
    >
      {languageLabels[l]}
    </a>
  ))}
</div>

<style>
  .lang-switcher {
    display: flex;
    gap: 2px;
    font-family: var(--font-ui);
    font-size: 12px;
  }

  .lang-option {
    display: inline-block;
    padding: 5px 8px;
    border-radius: var(--radius-sm);
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .lang-option:hover {
    color: var(--ink);
  }

  .lang-option.active {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    color: var(--forest);
  }
</style>
