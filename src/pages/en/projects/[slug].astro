---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectDetailView from '../../../views/ProjectDetailView.astro';
import { getDictionary } from '../../../i18n/utils';

const lang = 'en';
const t = getDictionary(lang);

export function getStaticPaths() {
  const dict = getDictionary('en');
  return dict.projects.items.map((project) => ({ params: { slug: project.slug } }));
}

const { slug } = Astro.params;
const project = t.projects.items.find((p) => p.slug === slug)!;
---

<BaseLayout lang={lang} page="home" path={`projects/${slug}`} title={`${project.title} — ${t.meta.title}`}>
  <ProjectDetailView lang={lang} slug={slug} />
</BaseLayout>
