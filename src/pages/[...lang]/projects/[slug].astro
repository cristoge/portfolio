---
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ButtonLink from '../../../components/ui/ButtonLink.astro';
import PillList from '../../../components/ui/PillList.astro';
import { getProjects } from '../../../data/projects';
import { getDictionary, getLangStaticPaths, localePath } from '../../../i18n/utils';
import { formatIndex } from '../../../lib/format';

export function getStaticPaths() {
  return getLangStaticPaths().flatMap(({ params, props: { lang } }) =>
    getProjects(lang).map((project) => ({
      params: { ...params, slug: project.slug },
      props: { lang, project },
    })),
  );
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang, project } = Astro.props;
const t = getDictionary(lang);
const d = t.projects.detail;
---

<BaseLayout lang={lang} title={`${project.title} — ${t.meta.title}`} activePage="home">
  <article class="page project-detail">
    <a href={`${localePath(lang, 'home')}#projects`} class="back-link"><span class="arrow arrow-back" aria-hidden="true">←</span> {d.back}</a>

    <header class="project-header">
      <p class="eyebrow">{d.context}</p>
      <h1>{project.title}</h1>
      <p class="project-summary lead">{project.description}</p>
    </header>

    <img src={project.image} alt={project.title} class="project-hero-image" />

    <p class="project-context">{project.context}</p>

    <section class="detail-block reveal">
      <h2 class="detail-heading">{d.depth}</h2>
      <ol class="depth-list">
        {project.depthTopics.map((topic, i) => (
          <li>
            <span class="depth-num">{formatIndex(i)}</span>
            <span>{topic}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="detail-block reveal">
      <h2 class="detail-heading">{d.stackLabel}</h2>
      <PillList items={project.stack} class="detail-pills" />
    </section>

    {project.outcome && (
      <section class="detail-block reveal">
        <h2 class="detail-heading">{d.outcome}</h2>
        <p class="outcome-text">{project.outcome}</p>
      </section>
    )}

    <div class="project-actions">
      <ButtonLink href={project.repoHref} external>{t.projects.links.repo}</ButtonLink>
      {project.demoHref && (
        <ButtonLink href={project.demoHref} variant="outline" external>{t.projects.links.demo}</ButtonLink>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail {
    max-width: 960px;
  }

  .back-link {
    display: inline-flex;
    gap: 10px;
    margin-block: -11px 45px;
    padding-block: 11px;
    color: var(--copy);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .project-header h1 {
    margin-top: 24px;
  }

  .project-summary {
    margin-top: 24px;
    max-width: 68ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-header > * {
      animation: fade-up 0.9s var(--ease-out) both;
    }
    .project-header h1 {
      animation-delay: 0.15s;
    }
    .project-header .project-summary,
    .project-hero-image {
      animation: fade-up 0.9s var(--ease-out) 0.3s both;
    }
  }

  .project-hero-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 56px 0;
    border: 1px solid var(--line-strong);
    object-fit: cover;
  }

  .project-context {
    max-width: 68ch;
    color: var(--copy);
    font-size: var(--fs-base);
    line-height: 1.65;
  }

  .detail-block {
    margin-top: 72px;
  }

  .detail-heading {
    margin-bottom: 28px;
    font-size: var(--fs-md);
  }

  .depth-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .depth-list li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    color: var(--copy);
    font-size: var(--fs-base);
    line-height: 1.6;
  }

  .depth-list li > span:last-child {
    max-width: 72ch;
  }

  .depth-num {
    padding-top: 4px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
  }

  .detail-block :global(.detail-pills) {
    gap: 8px;
  }

  .outcome-text {
    max-width: 68ch;
    font-size: var(--fs-md);
    line-height: 1.6;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 72px;
  }

  @media (max-width: 640px) {
    .depth-list li {
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>
