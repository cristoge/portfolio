---
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EducationSection from '../../components/home/EducationSection.astro';
import Hero from '../../components/home/Hero.astro';
import ProjectsSection from '../../components/home/ProjectsSection.astro';
import StackSection from '../../components/home/StackSection.astro';
import TerminalIntro from '../../components/home/TerminalIntro.astro';
import { getDictionary, getLangStaticPaths } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} activePage="home" intro>
  <TerminalIntro lang={lang} />
  <Hero lang={lang} />
  <ProjectsSection lang={lang} />
  <EducationSection lang={lang} />
  <StackSection lang={lang} />
</BaseLayout>
