---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonalView from '../../views/PersonalView.astro';
import { getDictionary } from '../../i18n/utils';

const lang = 'es';
const t = getDictionary(lang);
---

<BaseLayout lang={lang} page="personal" title={`${t.personal.kicker} — ${t.meta.title}`}>
  <PersonalView lang={lang} />
</BaseLayout>
